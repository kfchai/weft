def dedupe(xs: List[Int]) -> List[Int] =
  match xs {
    [] => [],
    [x] => [x],
    [x, y, ..rest] =>
      if x == y
      then dedupe([y] ++ rest)
      else [x] ++ dedupe([y] ++ rest),
  }

test "empty list" = dedupe([]) == []
test "single element" = dedupe([7]) == [7]
test "example from task" = dedupe([1, 1, 2, 1]) == [1, 2, 1]
test "all same" = dedupe([5, 5, 5, 5]) == [5]
test "no duplicates" = dedupe([1, 2, 3]) == [1, 2, 3]
test "longer runs" = dedupe([1, 1, 1, 2, 2, 3, 3, 3, 1]) == [1, 2, 3, 1]
test "idempotent" (xs: List[Int]) = dedupe(dedupe(xs)) == dedupe(xs)

def main(io: Io) -> Int = 0
