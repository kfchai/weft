type Slot = {start: Int, end: Int}

def overlaps(existing: List[Slot], start: Int, end: Int) -> Bool =
  match find(existing, (s: Slot) => start < s.end and s.start < end) {
    Some(_) => true,
    None => false,
  }

def merge_touching(xs: List[Slot]) -> List[Slot] =
  match xs {
    [] => [],
    [x, ..rest] => match rest {
      [] => [x],
      [y, ..more] =>
        if x.end == y.start
        then merge_touching([{start: x.start, end: y.end}] ++ more)
        else [x] ++ merge_touching(rest),
    },
  }

def book(existing: List[Slot], start: Int, end: Int) -> Result[List[Slot], Text] =
  if end <= start then Err("invalid")
  else if overlaps(existing, start, end) then Err("overlap")
  else Ok(merge_touching(sort_by(append(existing, {start: start, end: end}), (s: Slot) => s.start)))

def main(io: Io) -> Int = 0

test "empty end le start" = book([], 5, 5) == Err("invalid")
test "reversed interval" = book([], 7, 3) == Err("invalid")
test "insert into empty" = book([], 1, 3) == Ok([{start: 1, end: 3}])
test "overlap mid" = book([{start: 1, end: 3}], 2, 4) == Err("overlap")
test "overlap contained" = book([{start: 1, end: 10}], 4, 5) == Err("overlap")
test "overlap covers" = book([{start: 4, end: 5}], 1, 10) == Err("overlap")
test "touching is not overlap left" =
  book([{start: 0, end: 2}], 2, 3) == Ok([{start: 0, end: 3}])
test "touching is not overlap right" =
  book([{start: 4, end: 6}], 2, 4) == Ok([{start: 2, end: 6}])
test "bridge merges chain" =
  book([{start: 0, end: 2}, {start: 4, end: 6}], 2, 4) == Ok([{start: 0, end: 6}])
test "no touch keeps separate sorted" =
  book([{start: 3, end: 4}], 0, 2) == Ok([{start: 0, end: 2}, {start: 3, end: 4}])
test "insert between untouched" =
  book([{start: 0, end: 1}, {start: 8, end: 9}], 3, 5) ==
    Ok([{start: 0, end: 1}, {start: 3, end: 5}, {start: 8, end: 9}])
