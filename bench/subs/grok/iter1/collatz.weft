# Collatz step count: even n -> n/2, odd n -> 3n+1, until 1.

def collatz_steps(n: Int where n >= 1) -> Int =
  if n == 1 then 0
  else if n % 2 == 0 then 1 + collatz_steps(n / 2)
  else 1 + collatz_steps(3 * n + 1)

test "one is zero" = collatz_steps(1) == 0
test "two" = collatz_steps(2) == 1
test "three" = collatz_steps(3) == 7
test "four" = collatz_steps(4) == 2
test "six" = collatz_steps(6) == 8
test "seven" = collatz_steps(7) == 16
test "twenty seven" = collatz_steps(27) == 111

test "non-negative" (n: Int where n >= 1 and n <= 50) =
  collatz_steps(n) >= 0

test "even one more than half" (n: Int where n >= 2 and n <= 40 and n % 2 == 0) =
  collatz_steps(n) == 1 + collatz_steps(n / 2)

def main(io: Io) -> Int = 0
