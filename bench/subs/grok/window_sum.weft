# Maximum sum of any k consecutive elements, or None if the list is too short.

def sum_k(xs: List[Int], i: Int, k: Int) -> Int =
  if k <= 0 then 0
  else unwrap_or(list_get(xs, i), 0) + sum_k(xs, i + 1, k - 1)

def max_windows(xs: List[Int], k: Int, i: Int, last: Int) -> Int = {
  let s = sum_k(xs, i, k);
  if i >= last then s
  else max(s, max_windows(xs, k, i + 1, last))
}

def max_window_sum(xs: List[Int], k: Int where k >= 1) -> Option[Int] = {
  let n = len(xs);
  if n < k then None
  else Some(max_windows(xs, k, 0, n - k))
}

test "empty k1" = max_window_sum([], 1) == None
test "too short" = max_window_sum([1, 2], 3) == None
test "k equals length" = max_window_sum([1, 2, 3], 3) == Some(6)
test "k one" = max_window_sum([1, 2, 3], 1) == Some(3)
test "k two" = max_window_sum([1, 2, 3], 2) == Some(5)
test "k four none" = max_window_sum([1, 2, 3], 4) == None
test "singleton" = max_window_sum([5], 1) == Some(5)
test "negatives" = max_window_sum([-1, -2, -3], 2) == Some(-3)
test "mixed" = max_window_sum([2, -5, 8, -1, 3], 2) == Some(7)
test "all windows" = max_window_sum([4, 1, 9, 2], 3) == Some(14)
test "k one negatives" = max_window_sum([-4, -1, -9], 1) == Some(-1)

test "none iff short" (xs: List[Int], k: Int where k >= 1 and k <= 20) =
  (len(xs) < k) == (max_window_sum(xs, k) == None)

test "k one is max element" (xs: List[Int] where len(xs) > 0) =
  max_window_sum(xs, 1) == Some(fold(xs, unwrap_or(list_get(xs, 0), 0), (a: Int, b: Int) => max(a, b)))

def main(io: Io) -> Int = 0
