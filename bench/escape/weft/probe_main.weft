# ------------------------------------------------------------
# Differential probe (fragment).
#
# This file is NOT a standalone program. The harness builds the runnable
# probe by taking core.weft, truncating it at the separator line that
# immediately precedes "# Demo entry point", and appending this fragment
# verbatim. Every name here is prefixed pb_ so it cannot collide with a
# name in core.weft; the module's own `main` is truncated away, so the
# `main` below is the program entry point.
#
# Every printed line is the observable result of a call. Calls that can
# fail print their failure as a value ("err:<message>") so that a mutation
# late in the module is never hidden by an early halt.
# ------------------------------------------------------------

def pb_row(label: Text, value: Text) -> Text = label ++ " = " ++ value

def pb_product(p: Product) -> Text =
  p.sku ++ "/" ++ p.name ++ "/" ++ text_of_int(p.unit_cents)

def pb_opt_product(o: Option[Product]) -> Text =
  match o { Some(p) => "some:" ++ pb_product(p), None => "none" }

def pb_res_product(r: Result[Product, Text]) -> Text =
  match r { Ok(p) => "ok:" ++ pb_product(p), Err(e) => "err:" ++ e }

def pb_res_int(r: Result[Int, Text]) -> Text =
  match r { Ok(v) => "ok:" ++ text_of_int(v), Err(e) => "err:" ++ e }

def pb_stock(s: Stock) -> Text = s.sku ++ ":" ++ text_of_int(s.qty)

def pb_opt_stock(o: Option[Stock]) -> Text =
  match o { Some(s) => "some:" ++ pb_stock(s), None => "none" }

def pb_inv(inv: List[Stock]) -> Text =
  "[" ++ join(map(inv, (s: Stock) => pb_stock(s)), " ") ++ "]"

def pb_res_inv(r: Result[List[Stock], Text]) -> Text =
  match r { Ok(inv) => "ok:" ++ pb_inv(inv), Err(e) => "err:" ++ e }

def pb_units(r: Result[List[Stock], Text]) -> Text =
  match r { Ok(inv) => "ok:" ++ text_of_int(total_units(inv)), Err(e) => "err:" ++ e }

def pb_line(l: Line) -> Text = l.sku ++ "x" ++ text_of_int(l.qty)

def pb_opt_line(o: Option[Line]) -> Text =
  match o { Some(l) => "some:" ++ pb_line(l), None => "none" }

def pb_cart(cart: List[Line]) -> Text =
  "[" ++ join(map(cart, (l: Line) => pb_line(l)), " ") ++ "]"

def pb_coupon(c: Coupon) -> Text = c.sku ++ "@" ++ text_of_int(c.percent)

def pb_opt_coupon(o: Option[Coupon]) -> Text =
  match o { Some(c) => "some:" ++ pb_coupon(c), None => "none" }

def pb_pricing(p: Pricing) -> Text =
  "sub=" ++ text_of_int(p.subtotal) ++ " disc=" ++ text_of_int(p.discount)
    ++ " ship=" ++ text_of_int(p.shipping) ++ " total=" ++ text_of_int(p.total)

def pb_res_pricing(r: Result[Pricing, Text]) -> Text =
  match r { Ok(p) => "ok:" ++ pb_pricing(p), Err(e) => "err:" ++ e }

def pb_order(o: Order) -> Text =
  "#" ++ text_of_int(o.id) ++ " " ++ state_name(o.state) ++ " " ++ pb_cart(o.lines)
    ++ " total=" ++ text_of_int(o.total_cents)

def pb_res_order(r: Result[Order, Text]) -> Text =
  match r { Ok(o) => "ok:" ++ pb_order(o), Err(e) => "err:" ++ e }

def pb_placement(pl: Placement) -> Text =
  pb_order(pl.order) ++ " inv=" ++ pb_inv(pl.inv)

def pb_res_placement(r: Result[Placement, Text]) -> Text =
  match r { Ok(pl) => "ok:" ++ pb_placement(pl), Err(e) => "err:" ++ e }

def pb_opt_text(o: Option[Text]) -> Text =
  match o { Some(t) => "some:" ++ t, None => "none" }

# ---- probe data ----

def pb_skus: List[Text] =
