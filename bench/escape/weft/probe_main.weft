   {sku: "POT-001", qty: 1}, {sku: "POT-001", qty: 2}, {sku: "KTL-001", qty: 1}]

# ---- probe entry point ----

def main(io: Io) -> Int = {
  let _ = print(io, pb_row("len catalog", text_of_int(len(catalog))));
  let _ = print(io, join(map(catalog, (p: Product) => pb_row("catalog", pb_product(p))), "\n"));
  let _ = print(io, join(map(pb_skus, (s: Text) =>
    pb_row("find_product " ++ s, pb_opt_product(find_product(s)))), "\n"));
  let _ = print(io, join(map(pb_skus, (s: Text) =>
    pb_row("product_or_err " ++ s, pb_res_product(product_or_err(s)))), "\n"));
  let _ = print(io, join(map(pb_skus, (s: Text) =>
    pb_row("unit_price " ++ s, pb_res_int(unit_price(s)))), "\n"));
  let _ = print(io, join(map([0, 1, 2, 8, 9, 10, 11, 19, 20, 50, 89, 90, 98, 99], (n: Int) =>
    pb_row("pad2 " ++ text_of_int(n), pad2(n))), "\n"));
  let _ = print(io, join(map(
    [0, 1, 5, 9, 10, 50, 99, 100, 101, 105, 110, 150, 199, 200, 999, 1000, 1005,
     1050, 1205, 1250, 9999, 10000, 10001, 100000, 123456, 999999], (n: Int) =>
    pb_row("format_cents " ++ text_of_int(n), format_cents(n))), "\n"));
  let _ = print(io, pb_row("initial_stock", pb_inv(initial_stock)));
  let _ = print(io, pb_row("len initial_stock", text_of_int(len(initial_stock))));
  let _ = print(io, join(map(initial_stock, (s: Stock) =>
    pb_row("stock", pb_stock(s))), "\n"));
  let _ = print(io, pb_row("total_units initial_stock", text_of_int(total_units(initial_stock))));
  let _ = print(io, pb_row("total_units empty", text_of_int(total_units(pb_no_stock))));
  let _ = print(io, join(map(pb_skus, (s: Text) =>
    pb_row("find_stock " ++ s, pb_opt_stock(find_stock(initial_stock, s)))), "\n"));
  let _ = print(io, pb_row("find_stock empty TEA-001", pb_opt_stock(find_stock(pb_no_stock, "TEA-001"))));
  let _ = print(io, join(map(pb_skus, (s: Text) =>
    pb_row("stock_qty " ++ s, text_of_int(stock_qty(initial_stock, s)))), "\n"));
  let _ = print(io, pb_row("stock_qty empty TEA-001", text_of_int(stock_qty(pb_no_stock, "TEA-001"))));
  let _ = print(io, join(map(pb_take_cases, (c: Line) =>
    pb_row("take_stock " ++ pb_line(c), pb_res_inv(take_stock(initial_stock, c.sku, c.qty)))), "\n"));
  let _ = print(io, pb_row("take_stock empty TEA-001 1", pb_res_inv(take_stock(pb_no_stock, "TEA-001", 1))));
  let _ = print(io, join(map(pb_restock_cases, (c: Line) =>
    pb_row("restock " ++ pb_line(c), pb_res_inv(restock(initial_stock, c.sku, c.qty)))), "\n"));
  let _ = print(io, pb_row("restock empty TEA-001 1", pb_res_inv(restock(pb_no_stock, "TEA-001", 1))));
  let _ = print(io, pb_row("total_units after take POT-001 4", pb_units(take_stock(initial_stock, "POT-001", 4))));
  let _ = print(io, pb_row("total_units after restock POT-001 100", pb_units(restock(initial_stock, "POT-001", 100))));
  let _ = print(io, pb_row("add_to_cart empty TEA-001 1", pb_cart(add_to_cart(pb_no_lines, "TEA-001", 1))));
  let _ = print(io, pb_row("cart_a", pb_cart(pb_cart_a)));
  let _ = print(io, pb_row("cart_b", pb_cart(pb_cart_b)));
  let _ = print(io, pb_row("cart_c", pb_cart(pb_cart_c)));
  let _ = print(io, pb_row("cart_bad", pb_cart(pb_cart_bad)));
  let _ = print(io, pb_row("add_to_cart merge head", pb_cart(add_to_cart(pb_cart_c, "TEA-001", 10))));
  let _ = print(io, pb_row("add_to_cart merge mid", pb_cart(add_to_cart(pb_cart_c, "POT-001", 10))));
  let _ = print(io, pb_row("add_to_cart merge tail", pb_cart(add_to_cart(pb_cart_c, "HNY-001", 10))));
  let _ = print(io, pb_row("add_to_cart new sku", pb_cart(add_to_cart(pb_cart_c, "KTL-001", 1))));
  let _ = print(io, join(map(["TEA-001", "POT-001", "HNY-001", "KTL-001", "ZZZ"], (s: Text) =>
    pb_row("cart_qty cart_c " ++ s, text_of_int(cart_qty(pb_cart_c, s)))), "\n"));
  let _ = print(io, pb_row("cart_qty empty TEA-001", text_of_int(cart_qty(pb_no_lines, "TEA-001"))));
  let _ = print(io, pb_row("cart_qty cart_bad ZZZ", text_of_int(cart_qty(pb_cart_bad, "ZZZ"))));
  let _ = print(io, pb_row("cart_count empty", text_of_int(cart_count(pb_no_lines))));
  let _ = print(io, pb_row("cart_count cart_a", text_of_int(cart_count(pb_cart_a))));
  let _ = print(io, pb_row("cart_count cart_b", text_of_int(cart_count(pb_cart_b))));
  let _ = print(io, pb_row("cart_count cart_c", text_of_int(cart_count(pb_cart_c))));
  let _ = print(io, pb_row("cart_count cart_bad", text_of_int(cart_count(pb_cart_bad))));
  let _ = print(io, join(map(pb_cost_cases, (l: Line) =>
    pb_row("line_cost " ++ pb_line(l), pb_res_int(line_cost(l)))), "\n"));
  let _ = print(io, pb_row("cart_subtotal empty", pb_res_int(cart_subtotal(pb_no_lines))));
  let _ = print(io, pb_row("cart_subtotal cart_a", pb_res_int(cart_subtotal(pb_cart_a))));
  let _ = print(io, pb_row("cart_subtotal cart_b", pb_res_int(cart_subtotal(pb_cart_b))));
  let _ = print(io, pb_row("cart_subtotal cart_c", pb_res_int(cart_subtotal(pb_cart_c))));
  let _ = print(io, pb_row("cart_subtotal cart_bad", pb_res_int(cart_subtotal(pb_cart_bad))));
  let _ = print(io, pb_row("cart_subtotal two unknown",
    pb_res_int(cart_subtotal([{sku: "ZZZ", qty: 1}, {sku: "YYY", qty: 1}]))));
  let _ = print(io, pb_row("cart_subtotal unknown at tail",
    pb_res_int(cart_subtotal([{sku: "TEA-001", qty: 1}, {sku: "ZZZ", qty: 1}]))));
  let _ = print(io, join(map([1, 2, 45, 89, 90], (n: Int) =>
    pb_row("make_coupon TEA-001 " ++ text_of_int(n), pb_coupon(make_coupon("TEA-001", n)))), "\n"));
  let _ = print(io, pb_row("pb_coupons", join(map(pb_coupons, (c: Coupon) => pb_coupon(c)), " ")));
  let _ = print(io, join(map(
    [0, 1, 9999, 10000, 10001, 10002, 20000, 49999, 50000, 50001, 50002, 100000, 500000, 999999],
    (n: Int) => pb_row("tier_percent " ++ text_of_int(n), text_of_int(tier_percent(n)))), "\n"));
  let _ = print(io, join(map(
    [0, 1, 19, 20, 9999, 10000, 10001, 10019, 10020, 20000, 49999, 50000, 50001,
     50019, 50020, 100000, 500000, 999999],
    (n: Int) => pb_row("tier_discount " ++ text_of_int(n), text_of_int(tier_discount(n)))), "\n"));
  let _ = print(io, join(map(["TEA-001", "POT-001", "HNY-001", "KTL-001", "ZZZ"], (s: Text) =>
    pb_row("coupon_for pb_coupons " ++ s, pb_opt_coupon(coupon_for(pb_coupons, s)))), "\n"));
  let _ = print(io, pb_row("coupon_for empty TEA-001", pb_opt_coupon(coupon_for(pb_no_coupons, "TEA-001"))));
  let _ = print(io, join(map(pb_coupon_line_cases, (l: Line) =>
    pb_row("line_coupon_discount " ++ pb_line(l), pb_res_int(line_coupon_discount(pb_coupons, l)))), "\n"));
  let _ = print(io, pb_row("line_coupon_discount 1pct TEA-001x1",
    pb_res_int(line_coupon_discount([make_coupon("TEA-001", 1)], {sku: "TEA-001", qty: 1}))));
  let _ = print(io, pb_row("line_coupon_discount 90pct TEA-001x1",
    pb_res_int(line_coupon_discount([make_coupon("TEA-001", 90)], {sku: "TEA-001", qty: 1}))));
  let _ = print(io, pb_row("line_coupon_discount no coupons TEA-001x2",
    pb_res_int(line_coupon_discount(pb_no_coupons, {sku: "TEA-001", qty: 2}))));
  let _ = print(io, pb_row("coupon_discount empty empty", pb_res_int(coupon_discount(pb_no_coupons, pb_no_lines))));
  let _ = print(io, pb_row("coupon_discount empty cart_c", pb_res_int(coupon_discount(pb_no_coupons, pb_cart_c))));
  let _ = print(io, pb_row("coupon_discount pb_coupons empty", pb_res_int(coupon_discount(pb_coupons, pb_no_lines))));
  let _ = print(io, pb_row("coupon_discount pb_coupons cart_a", pb_res_int(coupon_discount(pb_coupons, pb_cart_a))));
  let _ = print(io, pb_row("coupon_discount pb_coupons cart_c", pb_res_int(coupon_discount(pb_coupons, pb_cart_c))));
  let _ = print(io, pb_row("coupon_discount pb_coupons cart_bad", pb_res_int(coupon_discount(pb_coupons, pb_cart_bad))));
  let _ = print(io, join(map(zip(pb_clamp_subs, pb_clamp_discs), (p: {fst: Int, snd: Int}) =>
    pb_row("clamp_total " ++ text_of_int(p.fst) ++ " " ++ text_of_int(p.snd),
      text_of_int(clamp_total(p.fst, p.snd)))), "\n"));
  let _ = print(io, join(map([0, 1, 499, 500, 29998, 29999, 30000, 30001, 30500, 50000, 999999], (n: Int) =>
    pb_row("shipping_fee " ++ text_of_int(n), text_of_int(shipping_fee(n)))), "\n"));
  let _ = print(io, pb_row("price_cart empty none", pb_res_pricing(price_cart(pb_no_lines, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart cart_a none", pb_res_pricing(price_cart(pb_cart_a, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart cart_a coupons", pb_res_pricing(price_cart(pb_cart_a, pb_coupons))));
  let _ = print(io, pb_row("price_cart cart_c none", pb_res_pricing(price_cart(pb_cart_c, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart cart_c coupons", pb_res_pricing(price_cart(pb_cart_c, pb_coupons))));
  let _ = print(io, pb_row("price_cart sub10000 none", pb_res_pricing(price_cart(pb_cart_10000, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart sub11250 none", pb_res_pricing(price_cart(pb_cart_11250, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart sub50000 none", pb_res_pricing(price_cart(pb_cart_50000, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart sub50950 none", pb_res_pricing(price_cart(pb_cart_50950, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart sub31550 none", pb_res_pricing(price_cart(pb_cart_31550, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart sub31650 none", pb_res_pricing(price_cart(pb_cart_31650, pb_no_coupons))));
  let _ = print(io, pb_row("price_cart huge 90pct",
    pb_res_pricing(price_cart(pb_cart_huge, [make_coupon("POT-001", 90)]))));
  let _ = print(io, pb_row("price_cart huge 1pct",
    pb_res_pricing(price_cart(pb_cart_huge, [make_coupon("POT-001", 1)]))));
  let _ = print(io, pb_row("price_cart cart_bad coupons", pb_res_pricing(price_cart(pb_cart_bad, pb_coupons))));
  let _ = print(io, join(map(pb_states, (s: OrderState) =>
    pb_row("state_name", state_name(s))), "\n"));
  let _ = print(io, join(map(pb_states, (a: OrderState) =>
    join(map(pb_states, (b: OrderState) =>
      pb_row("can_transition " ++ state_name(a) ++ " " ++ state_name(b),
        text_of_bool(can_transition(a, b)))), "\n")), "\n"));
  let _ = print(io, join(map(pb_states, (a: OrderState) =>
    join(map(pb_states, (b: OrderState) =>
      pb_row("transition " ++ state_name(a) ++ " " ++ state_name(b),
        pb_res_order(transition({id: 9, lines: pb_cart_a, state: a, total_cents: 7}, b)))), "\n")), "\n"));
  let _ = print(io, pb_row("new_order 1 empty", pb_order(new_order(1, pb_no_lines))));
  let _ = print(io, pb_row("new_order 2 cart_a", pb_order(new_order(2, pb_cart_a))));
