# ============================================================
# orderflow.weft — a single-file order-management system.
# Domains: money/catalog, inventory, cart, pricing, orders,
# reporting. All money is Int cents; all math is integer math.
# ============================================================

# ------------------------------------------------------------
# 1. Money & catalog
# ------------------------------------------------------------

# A product in the catalog; unit_cents is the price of one unit in cents.
type Product = {sku: Text, name: Text, unit_cents: Int}

# The full store catalog: every product this store can sell.
def catalog: List[Product] = [
  {sku: "TEA-001", name: "Green Tea Tin", unit_cents: 1250},
  {sku: "TEA-002", name: "Earl Grey Tin", unit_cents: 1350},
  {sku: "MUG-001", name: "Stoneware Mug", unit_cents: 1800},
  {sku: "POT-001", name: "Cast Iron Teapot", unit_cents: 6400},
  {sku: "HNY-001", name: "Wildflower Honey", unit_cents: 950},
  {sku: "KTL-001", name: "Gooseneck Kettle", unit_cents: 8900}
]

# Find a product by sku with stdlib find; None when the sku is unknown.
def find_product(sku: Text) -> Option[Product] =
  find(catalog, (p: Product) => p.sku == sku)

# Find a product by sku, or an Err naming the missing sku.
def product_or_err(sku: Text) -> Result[Product, Text] =
  ok_or(find_product(sku), "unknown sku: " ++ sku)

# The unit price in cents for a sku, or an Err for unknown skus.
def unit_price(sku: Text) -> Result[Int, Text] = {
  let p = product_or_err(sku)?;
  Ok(p.unit_cents)
}

# Left-pad a small non-negative Int to two digits, for cents formatting.
def pad2(n: Int where n >= 0 and n <= 99) -> Text =
  if n < 10 then "0" ++ text_of_int(n) else text_of_int(n)

# Render a non-negative cents amount as dollars, e.g. 1250 -> "$12.50".
def format_cents(cents: Int where cents >= 0) -> Text =
  "$" ++ text_of_int(cents / 100) ++ "." ++ pad2(cents % 100)

# ------------------------------------------------------------
# 2. Inventory
# ------------------------------------------------------------

# A stock level for one sku; the [W42] invariant makes negative stock unrepresentable.
type Stock = {sku: Text, qty: Int} where qty >= 0

# The opening inventory for the demo store.
def initial_stock: List[Stock] = [
  Stock{sku: "TEA-001", qty: 40},
  Stock{sku: "TEA-002", qty: 25},
  Stock{sku: "MUG-001", qty: 12},
  Stock{sku: "POT-001", qty: 4},
  Stock{sku: "HNY-001", qty: 30},
  Stock{sku: "KTL-001", qty: 6}
]

# The stock record for a sku, if the inventory tracks it.
def find_stock(inv: List[Stock], sku: Text) -> Option[Stock] =
  find(inv, (s: Stock) => s.sku == sku)

# The quantity on hand for a sku; unknown skus count as zero.
def stock_qty(inv: List[Stock], sku: Text) -> Int =
  match find_stock(inv, sku) {
    Some(s) => s.qty,
    None => 0,
  }

# Remove qty units of a sku from inventory, or Err when stock is insufficient.
def take_stock(inv: List[Stock], sku: Text, qty: Int where qty > 0) -> Result[List[Stock], Text] =
  if stock_qty(inv, sku) < qty
  then Err("insufficient stock for " ++ sku ++ ": have "
       ++ text_of_int(stock_qty(inv, sku)) ++ ", want " ++ text_of_int(qty))
  else Ok(map(inv, (s: Stock) =>
    if s.sku == sku then Stock{..s, qty: s.qty - qty} else s))

# Add qty units of a tracked sku back to inventory, or Err for unknown skus.
def restock(inv: List[Stock], sku: Text, qty: Int where qty > 0) -> Result[List[Stock], Text] =
  match find_stock(inv, sku) {
    Some(_) => Ok(map(inv, (s: Stock) =>
      if s.sku == sku then Stock{..s, qty: s.qty + qty} else s)),
    None => Err("cannot restock unknown sku: " ++ sku),
  }

# Total units on hand across every sku in the inventory.
def total_units(inv: List[Stock]) -> Int =
  fold(inv, 0, (acc: Int, s: Stock) => acc + s.qty)

# ------------------------------------------------------------
# 3. Cart
# ------------------------------------------------------------

# One cart line: a sku and how many units of it the shopper wants.
type Line = {sku: Text, qty: Int}

# Add qty units of a sku to a cart, merging into an existing line for that sku.
def add_to_cart(cart: List[Line], sku: Text, qty: Int where qty > 0) -> List[Line] =
  match find(cart, (l: Line) => l.sku == sku) {
    Some(_) => map(cart, (l: Line) =>
      if l.sku == sku then {..l, qty: l.qty + qty} else l),
    None => append(cart, {sku: sku, qty: qty}),
  }

# The quantity of a sku currently in the cart; zero when absent.
def cart_qty(cart: List[Line], sku: Text) -> Int =
  match find(cart, (l: Line) => l.sku == sku) {
    Some(l) => l.qty,
    None => 0,
  }

# Total number of units across all cart lines.
def cart_count(cart: List[Line]) -> Int =
  fold(cart, 0, (acc: Int, l: Line) => acc + l.qty)

# The cost of one cart line in cents, or Err when the sku is not in the catalog.
def line_cost(l: Line) -> Result[Int, Text] = {
  let price = unit_price(l.sku)?;
  Ok(price * l.qty)
}

# The cart subtotal in cents before any discount, or the first lookup Err.
def cart_subtotal(cart: List[Line]) -> Result[Int, Text] =
  match cart {
    [] => Ok(0),
    [l, ..rest] => {
      let head = line_cost(l)?;
      let tail = cart_subtotal(rest)?;
      Ok(head + tail)
    },
  }

# ------------------------------------------------------------
# 4. Pricing
# ------------------------------------------------------------

# A per-sku coupon granting percent off that sku's line cost.
type Coupon = {sku: Text, percent: Int}

# Construct a coupon, enforcing that percent stays within 1..90.
def make_coupon(sku: Text, percent: Int where percent >= 1 and percent <= 90) -> Coupon =
  {sku: sku, percent: percent}

# The tier discount percent a subtotal earns: 10% over 50000, 5% over 10000.
def tier_percent(subtotal_cents: Int where subtotal_cents >= 0) -> Int =
  if subtotal_cents > 50000 then 10
  else if subtotal_cents > 10000 then 5
  else 0

# The tier discount in cents for a subtotal, using integer math.
def tier_discount(subtotal_cents: Int where subtotal_cents >= 0) -> Int =
  subtotal_cents * tier_percent(subtotal_cents) / 100

# The first coupon that applies to a sku, if any.
def coupon_for(coupons: List[Coupon], sku: Text) -> Option[Coupon] =
  find(coupons, (c: Coupon) => c.sku == sku)

# The coupon discount in cents for one cart line, or Err for unknown skus.
def line_coupon_discount(coupons: List[Coupon], l: Line) -> Result[Int, Text] = {
  let cost = line_cost(l)?;
  match coupon_for(coupons, l.sku) {
    Some(c) => Ok(cost * c.percent / 100),
    None => Ok(0),
  }
}

# The total coupon discount in cents across the whole cart.
def coupon_discount(coupons: List[Coupon], cart: List[Line]) -> Result[Int, Text] =
  match cart {
    [] => Ok(0),
    [l, ..rest] => {
      let head = line_coupon_discount(coupons, l)?;
      let tail = coupon_discount(coupons, rest)?;
      Ok(head + tail)
    },
  }

# Subtract a discount from a subtotal without ever going below zero.
def clamp_total(subtotal_cents: Int where subtotal_cents >= 0, discount_cents: Int where discount_cents >= 0) -> Int =
  max(0, subtotal_cents - discount_cents)

# A fully priced cart: subtotal, combined discount, shipping fee, final total.
type Pricing = {subtotal: Int, discount: Int, shipping: Int, total: Int}

# The flat shipping fee in cents, waived at or above 30000c post-discount.
def shipping_fee(discounted_cents: Int where discounted_cents >= 0) -> Int =
  if discounted_cents >= 30000 then 0 else 500

# Price a cart end to end: subtotal, tier + coupon discounts, shipping, total.
def price_cart(cart: List[Line], coupons: List[Coupon]) -> Result[Pricing, Text] = {
  let sub = cart_subtotal(cart)?;
  let coup = coupon_discount(coupons, cart)?;
  let disc = tier_discount(sub) + coup;
  let discounted = clamp_total(sub, disc);
  let ship = shipping_fee(discounted);
  Ok({subtotal: sub, discount: disc, shipping: ship, total: discounted + ship})
}

# ------------------------------------------------------------
# 5. Orders
# ------------------------------------------------------------

# The order lifecycle state machine.
type OrderState = Draft | Placed | Shipped | Cancelled

# An order: an id, its cart lines, its lifecycle state, and its priced total.
type Order = {id: Int, lines: List[Line], state: OrderState, total_cents: Int}

# The result of placing (or cancelling) an order: the order plus updated inventory.
type Placement = {order: Order, inv: List[Stock]}

# A human-readable name for an order state.
def state_name(s: OrderState) -> Text =
  match s {
    Draft => "draft",
    Placed => "placed",
    Shipped => "shipped",
    Cancelled => "cancelled",
  }

# Whether the state machine allows moving from one state to another.
def can_transition(from: OrderState, to: OrderState) -> Bool =
  match from {
    Draft => match to { Placed => true, Cancelled => true, _ => false },
    Placed => match to { Shipped => true, Cancelled => true, _ => false },
    Shipped => false,
    Cancelled => false,
  }

# Move an order to a new state, or Err naming the illegal transition.
def transition(o: Order, to: OrderState) -> Result[Order, Text] =
  if can_transition(o.state, to)
  then Ok({..o, state: to})
  else Err("illegal transition: " ++ state_name(o.state) ++ " -> " ++ state_name(to))

# Create a fresh draft order for a cart, not yet priced or placed.
def new_order(id: Int, lines: List[Line]) -> Order =
  {id: id, lines: lines, state: Draft, total_cents: 0}

# Take stock for every line of an order, or Err on the first shortage.
def take_lines(inv: List[Stock], lines: List[Line]) -> Result[List[Stock], Text] =
  match lines {
    [] => Ok(inv),
    [l, ..rest] => {
      let next = take_stock(inv, l.sku, l.qty)?;
      take_lines(next, rest)
    },
  }

# Restock every line of an order, or Err on the first unknown sku.
def restock_lines(inv: List[Stock], lines: List[Line]) -> Result[List[Stock], Text] =
  match lines {
    [] => Ok(inv),
    [l, ..rest] => {
      let next = restock(inv, l.sku, l.qty)?;
      restock_lines(next, rest)
    },
  }

# Place a draft order: price it, take stock for every line, move it to Placed.
def place_order(o: Order, inv: List[Stock], coupons: List[Coupon]) -> Result[Placement, Text] =
  match o.state {
    Draft =>
      if len(o.lines) == 0
      then Err("cannot place an empty order")
      else {
        let priced = price_cart(o.lines, coupons)?;
        let taken = take_lines(inv, o.lines)?;
        let placed = transition({..o, total_cents: priced.total}, Placed)?;
        Ok({order: placed, inv: taken})
      },
    _ => Err("only draft orders can be placed, got " ++ state_name(o.state)),
  }

# Ship a placed order, or Err if the transition is illegal.
def ship_order(o: Order) -> Result[Order, Text] =
  transition(o, Shipped)

# Cancel a draft or placed order, or Err if already shipped or cancelled.
def cancel_order(o: Order) -> Result[Order, Text] =
  transition(o, Cancelled)

# Cancel a placed order and return its stock, yielding order + restored inventory.
def cancel_and_restock(o: Order, inv: List[Stock]) -> Result[Placement, Text] = {
  let cancelled = cancel_order(o)?;
  let restored = restock_lines(inv, o.lines)?;
  Ok({order: cancelled, inv: restored})
}

# ------------------------------------------------------------
# 6. Reporting
# ------------------------------------------------------------

# Revenue an order contributes: its total when placed or shipped, else zero.
def order_revenue(o: Order) -> Int =
  match o.state {
    Placed => o.total_cents,
    Shipped => o.total_cents,
    _ => 0,
  }

# Total revenue in cents across a list of orders.
def total_revenue(orders: List[Order]) -> Int =
  fold(orders, 0, (acc: Int, o: Order) => acc + order_revenue(o))

# Every revenue-bearing line across a list of orders, in order of appearance.
def revenue_lines(orders: List[Order]) -> List[Line] =
  fold(orders, [], (acc: List[Line], o: Order) =>
    if order_revenue(o) > 0 then acc ++ o.lines else acc)

# Units sold per sku, merged in first-appearance order via cart merging.
def sku_totals(orders: List[Order]) -> List[Line] =
  fold(revenue_lines(orders), [], (acc: List[Line], l: Line) =>
    add_to_cart(acc, l.sku, l.qty))

# The line with the highest qty; ties keep the line appearing earlier.
def max_line(lines: List[Line]) -> Option[Line] =
  match lines {
    [] => None,
    [l, ..rest] =>
      match max_line(rest) {
        None => Some(l),
        Some(b) => if b.qty > l.qty then Some(b) else Some(l),
      },
  }

# The best-selling sku across orders; ties go to the first-appearing sku.
def best_seller(orders: List[Order]) -> Option[Text] =
  match max_line(sku_totals(orders)) {
    Some(l) => Some(l.sku),
    None => None,
  }

# The display name for a sku, falling back to the raw sku when unknown.
def display_name(sku: Text) -> Text =
  match find_product(sku) {
    Some(p) => p.name,
    None => sku,
  }

# One formatted receipt row: "name x qty @ unit = amount".
def receipt_row(l: Line) -> Text =
  match find_product(l.sku) {
    Some(p) => "  " ++ p.name ++ " x " ++ text_of_int(l.qty)
      ++ " @ " ++ format_cents(p.unit_cents)
      ++ " = " ++ format_cents(p.unit_cents * l.qty),
    None => "  " ++ l.sku ++ " x " ++ text_of_int(l.qty) ++ " (unknown sku)",
  }

# A labelled money row for the receipt footer.
def money_row(label: Text, cents: Int where cents >= 0) -> Text =
  "  " ++ label ++ ": " ++ format_cents(cents)

# A full multi-line receipt Text for an order and its coupons.
def receipt(o: Order, coupons: List[Coupon]) -> Text =
  match price_cart(o.lines, coupons) {
    Ok(p) => join(
      ["=== order #" ++ text_of_int(o.id) ++ " (" ++ state_name(o.state) ++ ") ==="]
        ++ map(o.lines, (l: Line) => receipt_row(l))
        ++ [money_row("subtotal", p.subtotal),
            money_row("discount", p.discount),
            money_row("Shipping", p.shipping),
            money_row("total", p.total)],
      "\n"),
    Err(e) => "receipt error: " ++ e,
  }

# ------------------------------------------------------------
# Tests — 1. Money & catalog
# ------------------------------------------------------------

test "catalog has six products" =
  len(catalog) == 6

test "find product hit" =
  match find_product("MUG-001") {
    Some(p) => p.name == "Stoneware Mug",
    None => false,
  }

test "find product miss" =
  find_product("NOPE") == None

test "unit price ok" =
  unit_price("HNY-001") == Ok(950)

test "unit price unknown sku" =
  unit_price("NOPE") == Err("unknown sku: NOPE")

test "format cents pads sub-dime remainders" =
  format_cents(1205) == "$12.05"

test "format cents zero" =
  format_cents(0) == "$0.00"

test "format cents always has a dot" (n: Int where n >= 0) =
  contains(format_cents(n), ".")

test "pad2 is always two chars" (n: Int where n >= 0 and n <= 99) =
  text_len(pad2(n)) == 2

# ------------------------------------------------------------
# Tests — 2. Inventory
# ------------------------------------------------------------

test "stock qty tracked" =
  stock_qty(initial_stock, "POT-001") == 4

test "stock qty unknown is zero" =
  stock_qty(initial_stock, "NOPE") == 0

test "take stock reduces" =
  match take_stock(initial_stock, "POT-001", 3) {
    Ok(inv) => stock_qty(inv, "POT-001") == 1,
    Err(_) => false,
  }

test "take stock reports insufficiency" =
  match take_stock(initial_stock, "POT-001", 5) {
    Err(m) => contains(m, "insufficient"),
    Ok(_) => false,
  }

test "take stock conserves other skus" =
  match take_stock(initial_stock, "TEA-001", 10) {
    Ok(inv) => total_units(inv) == total_units(initial_stock) - 10,
    Err(_) => false,
  }

test "restock unknown sku errs" =
  restock(initial_stock, "NOPE", 5) == Err("cannot restock unknown sku: NOPE")

test "restock then take round-trips" (q: Int where q > 0 and q < 500) =
  match restock(initial_stock, "MUG-001", q) {
    Ok(up) => match take_stock(up, "MUG-001", q) {
      Ok(down) => down == initial_stock,
      Err(_) => false,
    },
    Err(_) => false,
  }

# ------------------------------------------------------------
# Tests — 3. Cart
# ------------------------------------------------------------

test "add to cart appends new sku" =
  add_to_cart([], "TEA-001", 2) == [{sku: "TEA-001", qty: 2}]

test "add to cart merges duplicate sku into one line" =
  len(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-001", 2)) == 1

test "cart merge adds quantities" (a: Int where a > 0 and a < 1000, b: Int where b > 0 and b < 1000) =
  cart_qty(add_to_cart(add_to_cart([], "X", a), "X", b), "X") == a + b

test "cart qty absent is zero" =
  cart_qty(add_to_cart([], "TEA-001", 2), "MUG-001") == 0

test "cart count sums units" =
  cart_count(add_to_cart(add_to_cart([], "TEA-001", 2), "HNY-001", 1)) == 3

test "cart subtotal sums line costs" =
  cart_subtotal(add_to_cart(add_to_cart([], "TEA-001", 2), "HNY-001", 1)) == Ok(3450)

test "cart subtotal unknown sku errs" =
  cart_subtotal([{sku: "NOPE", qty: 1}]) == Err("unknown sku: NOPE")

# ------------------------------------------------------------
# Tests — 4. Pricing
# ------------------------------------------------------------

test "no tier at or under 10000" =
  tier_percent(10000) == 0

test "five percent tier over 10000" =
  tier_percent(10001) == 5

test "ten percent tier over 50000" =
  tier_percent(50001) == 10

test "tier discount uses integer math" =
  tier_discount(20000) == 1000

test "tier discount stays within subtotal" (s: Int where s >= 0 and s < 1000000) = {
  let d = tier_discount(s);
  d >= 0 and d <= s
}

test "coupon applies to its sku" =
  line_coupon_discount([make_coupon("TEA-001", 20)], {sku: "TEA-001", qty: 2}) == Ok(500)

test "coupon skips other skus" =
  line_coupon_discount([make_coupon("TEA-001", 20)], {sku: "HNY-001", qty: 3}) == Ok(0)

test "final total never negative" (s: Int where s >= 0, d: Int where d >= 0) =
  clamp_total(s, d) >= 0

test "price cart combines tier and coupon discounts" =
  price_cart(add_to_cart([], "POT-001", 2), [make_coupon("POT-001", 10)])
    == Ok({subtotal: 12800, discount: 1920, shipping: 500, total: 11380})

test "shipping fee applied below threshold" =
  shipping_fee(29999) == 500

test "shipping fee waived at threshold" =
  shipping_fee(30000) == 0

test "shipping fee waived above threshold" =
  shipping_fee(50000) == 0

test "price cart charges shipping below threshold" =
  price_cart(add_to_cart([], "TEA-001", 2), [])
    == Ok({subtotal: 2500, discount: 0, shipping: 500, total: 3000})

test "price cart waives shipping above threshold" =
  price_cart(add_to_cart([], "POT-001", 5), [])
    == Ok({subtotal: 32000, discount: 1600, shipping: 0, total: 30400})

test "receipt shows shipping fee when charged" = {
  let r = receipt(new_order(21, add_to_cart([], "TEA-001", 2)), []);
  contains(r, "Shipping: $5.00") and contains(r, "total: $30.00")
}

test "receipt shows zero shipping when waived" = {
  let r = receipt(new_order(22, add_to_cart([], "POT-001", 5)), []);
  contains(r, "Shipping: $0.00") and contains(r, "total: $304.00")
}

# ------------------------------------------------------------
# Tests — 5. Orders
# ------------------------------------------------------------

test "draft can be placed" =
  can_transition(Draft, Placed)

test "placed can be cancelled" =
  can_transition(Placed, Cancelled)

test "shipped is terminal" =
  not can_transition(Shipped, Cancelled) and not can_transition(Shipped, Draft)

test "illegal transition errs" =
  match transition(new_order(1, []), Shipped) {
    Err(m) => contains(m, "illegal"),
    Ok(_) => false,
  }

test "place order takes stock and prices total" =
  match place_order(new_order(2, add_to_cart([], "MUG-001", 2)), initial_stock, []) {
    Ok(pl) => stock_qty(pl.inv, "MUG-001") == 10
      and pl.order.state == Placed
      and pl.order.total_cents == 4100,
    Err(_) => false,
  }

test "place order fails on shortage" =
  match place_order(new_order(3, add_to_cart([], "POT-001", 99)), initial_stock, []) {
    Err(m) => contains(m, "insufficient"),
    Ok(_) => false,
  }

test "empty order cannot be placed" =
  match place_order(new_order(4, []), initial_stock, []) {
    Err(m) => contains(m, "empty"),
    Ok(_) => false,
  }

test "an order cannot be placed twice" =
  match place_order(new_order(5, add_to_cart([], "HNY-001", 1)), initial_stock, []) {
    Ok(pl) => match place_order(pl.order, pl.inv, []) {
      Err(m) => contains(m, "only draft"),
      Ok(_) => false,
    },
    Err(_) => false,
  }

test "ship after place succeeds" =
  match place_order(new_order(6, add_to_cart([], "TEA-002", 1)), initial_stock, []) {
    Ok(pl) => ship_order(pl.order) == Ok({..pl.order, state: Shipped}),
    Err(_) => false,
  }

test "cancel and restock restores inventory" =
  match place_order(new_order(7, add_to_cart([], "KTL-001", 2)), initial_stock, []) {
    Ok(pl) => match cancel_and_restock(pl.order, pl.inv) {
      Ok(back) => back.inv == initial_stock and back.order.state == Cancelled,
      Err(_) => false,
    },
    Err(_) => false,
  }

# ------------------------------------------------------------
# Tests — 6. Reporting
# ------------------------------------------------------------

test "revenue counts placed and shipped only" =
  total_revenue([
    {id: 1, lines: [], state: Placed, total_cents: 100},
    {id: 2, lines: [], state: Draft, total_cents: 999},
    {id: 3, lines: [], state: Shipped, total_cents: 250},
    {id: 4, lines: [], state: Cancelled, total_cents: 400}
  ]) == 350

test "best seller picks the highest total qty" =
  best_seller([
    {id: 1, lines: [{sku: "A", qty: 2}], state: Placed, total_cents: 10},
    {id: 2, lines: [{sku: "B", qty: 5}], state: Shipped, total_cents: 10}
  ]) == Some("B")

test "best seller tie goes to first appearance" =
  best_seller([
    {id: 1, lines: [{sku: "A", qty: 3}], state: Placed, total_cents: 10},
    {id: 2, lines: [{sku: "B", qty: 3}], state: Placed, total_cents: 10}
  ]) == Some("A")

test "best seller merges across orders" =
  best_seller([
    {id: 1, lines: [{sku: "A", qty: 2}], state: Placed, total_cents: 10},
    {id: 2, lines: [{sku: "B", qty: 3}], state: Placed, total_cents: 10},
    {id: 3, lines: [{sku: "A", qty: 2}], state: Shipped, total_cents: 10}
  ]) == Some("A")

test "cancelled orders sell nothing" =
  best_seller([{id: 1, lines: [{sku: "A", qty: 9}], state: Cancelled, total_cents: 10}]) == None

test "best seller of no orders is None" =
  best_seller([]) == None

test "receipt names products and totals" = {
  let r = receipt(new_order(8, add_to_cart([], "TEA-001", 2)), []);
  contains(r, "Green Tea Tin") and contains(r, "subtotal") and contains(r, "$25.00")
}

test "receipt row flags unknown skus" =
  contains(receipt_row({sku: "ZZZ", qty: 1}), "unknown")

test "display name falls back to sku" =
  display_name("KTL-001") == "Gooseneck Kettle" and display_name("ZZZ") == "ZZZ"

# ------------------------------------------------------------
# Demo entry point
# ------------------------------------------------------------

# Demo: build a cart, place the order, print its receipt and a stock summary.
def main(io: Io) -> Int = {
  let cart = add_to_cart(add_to_cart(add_to_cart([], "TEA-001", 2), "POT-001", 1), "TEA-001", 1);
  let coupons = [make_coupon("TEA-001", 15)];
  match place_order(new_order(1001, cart), initial_stock, coupons) {
    Ok(pl) => {
      let _ = print(io, receipt(pl.order, coupons));
      let _ = print(io, "units left in stock: " ++ text_of_int(total_units(pl.inv)));
      let seller = unwrap_or(best_seller([pl.order]), "n/a");
      let _ = print(io, "best seller: " ++ display_name(seller));
      0
    },
    Err(e) => {
      let _ = print(io, "demo failed: " ++ e);
      1
    },
  }
}

# ------------------------------------------------------------
# 7. Customers & loyalty
# ------------------------------------------------------------

# A registered customer of the store.
type Customer = {id: Int, name: Text, email: Text}

# The customer directory for the demo store.
def customers: List[Customer] = [
  {id: 1, name: "Ada Chen", email: "ada@example.com"},
  {id: 2, name: "Bram Osei", email: "bram@example.com"},
  {id: 3, name: "Cleo Ito", email: "cleo@example.com"},
  {id: 4, name: "Devi Rao", email: "devi@example.com"},
  {id: 5, name: "Emil Novak", email: "emil@example.com"},
  {id: 6, name: "Fern Wilde", email: "fern@example.com"}
]

# Find a customer by id with stdlib find; None when the id is unknown.
def find_customer(id: Int) -> Option[Customer] =
  find(customers, (c: Customer) => c.id == id)

# Find a customer by email address, if any customer registered with it.
def find_customer_by_email(email: Text) -> Option[Customer] =
  find(customers, (c: Customer) => c.email == email)

# Find a customer by id, or an Err naming the missing id.
def customer_or_err(id: Int) -> Result[Customer, Text] =
  ok_or(find_customer(id), "unknown customer: " ++ text_of_int(id))

# A display label like "Ada Chen <ada@example.com>".
def customer_label(c: Customer) -> Text =
  c.name ++ " <" ++ c.email ++ ">"

# The display label for a customer id, falling back to "customer #id".
def customer_display(id: Int) -> Text =
  match find_customer(id) {
    Some(c) => customer_label(c),
    None => "customer #" ++ text_of_int(id),
  }

# A crude email shape check: the address must contain an "@" and a ".".
def valid_email(email: Text) -> Bool =
  contains(email, "@") and contains(email, ".")

# The smallest id strictly above every id in a directory.
def next_customer_id(dir: List[Customer]) -> Int =
  fold(dir, 0, (acc: Int, c: Customer) => max(acc, c.id)) + 1

# Add a customer to a directory, rejecting bad emails and duplicate ids.
def register_customer(dir: List[Customer], id: Int, name: Text, email: Text) -> Result[List[Customer], Text] =
  if not valid_email(email)
  then Err("invalid email: " ++ email)
  else match find(dir, (c: Customer) => c.id == id) {
    Some(_) => Err("duplicate customer id: " ++ text_of_int(id)),
    None => Ok(append(dir, {id: id, name: name, email: email})),
  }

# A loyalty balance; the [W42] invariant makes negative points unrepresentable.
type Loyalty = {customer_id: Int, points: Int} where points >= 0

# A fresh loyalty account with zero points for a customer.
def new_loyalty(customer_id: Int) -> Loyalty =
  Loyalty{customer_id: customer_id, points: 0}

# Points earned by spending: one point per full 100 cents of total.
def points_for_total(total_cents: Int where total_cents >= 0) -> Int =
  total_cents / 100

# Points an order earns: based on order_revenue, so drafts and cancels earn none.
def points_for_order(o: Order) -> Int =
  points_for_total(order_revenue(o))

# Credit a loyalty account with the points a spend of total_cents earns.
def earn_points(l: Loyalty, total_cents: Int where total_cents >= 0) -> Loyalty =
  Loyalty{..l, points: l.points + points_for_total(total_cents)}

# Credit a loyalty account for an order; non-revenue orders leave it unchanged.
def earn_for_order(l: Loyalty, o: Order) -> Loyalty =
  Loyalty{..l, points: l.points + points_for_order(o)}

# Debit points from an account, or Err when the balance is insufficient.
def redeem_points(l: Loyalty, pts: Int where pts > 0) -> Result[Loyalty, Text] =
  if l.points < pts
  then Err("insufficient points for customer " ++ text_of_int(l.customer_id)
       ++ ": have " ++ text_of_int(l.points) ++ ", want " ++ text_of_int(pts))
  else Ok(Loyalty{..l, points: l.points - pts})

# The cash value of a points balance: one cent per point.
def points_value_cents(pts: Int where pts >= 0) -> Int =
  pts

# Find the loyalty account for a customer id in a ledger, if it exists.
def find_loyalty(ledger: List[Loyalty], customer_id: Int) -> Option[Loyalty] =
  find(ledger, (l: Loyalty) => l.customer_id == customer_id)

# The loyalty account for a customer, defaulting to a zero account when absent.
def loyalty_or_new(ledger: List[Loyalty], customer_id: Int) -> Loyalty =
  match find_loyalty(ledger, customer_id) {
    Some(l) => l,
    None => new_loyalty(customer_id),
  }

# Record the earnings of an order in a ledger, updating or adding the entry.
def ledger_earn(ledger: List[Loyalty], customer_id: Int, o: Order) -> List[Loyalty] = {
  let updated = earn_for_order(loyalty_or_new(ledger, customer_id), o);
  match find_loyalty(ledger, customer_id) {
    Some(_) => map(ledger, (l: Loyalty) =>
      if l.customer_id == customer_id then updated else l),
    None => append(ledger, updated),
  }
}

# Total points outstanding across a whole loyalty ledger.
def ledger_points(ledger: List[Loyalty]) -> Int =
  fold(ledger, 0, (acc: Int, l: Loyalty) => acc + l.points)

# Redeem points from one ledger entry, or Err when absent or short.
def ledger_redeem(ledger: List[Loyalty], customer_id: Int, pts: Int where pts > 0) -> Result[List[Loyalty], Text] =
  match find_loyalty(ledger, customer_id) {
    None => Err("no loyalty account for customer " ++ text_of_int(customer_id)),
    Some(l) => {
      let updated = redeem_points(l, pts)?;
      Ok(map(ledger, (x: Loyalty) =>
        if x.customer_id == customer_id then updated else x))
    },
  }

# A one-line loyalty statement with the cash value of the balance.
def loyalty_statement(l: Loyalty) -> Text =
  customer_display(l.customer_id) ++ ": " ++ text_of_int(l.points)
    ++ " points (" ++ format_cents(points_value_cents(l.points)) ++ ")"

# ------------------------------------------------------------
# 8. Gift cards
# ------------------------------------------------------------

# A gift card; the [W42] invariant makes a negative balance unrepresentable.
type GiftCard = {code: Text, balance_cents: Int} where balance_cents >= 0

# Issue a new gift card with an opening balance in cents.
def issue_gift_card(code: Text, balance_cents: Int where balance_cents >= 0) -> GiftCard =
  GiftCard{code: code, balance_cents: balance_cents}

# Add value to an existing gift card.
def top_up(card: GiftCard, amount_cents: Int where amount_cents > 0) -> GiftCard =
  GiftCard{..card, balance_cents: card.balance_cents + amount_cents}

# The amount a card can pay toward a total: the smaller of balance and total.
def card_spend(card: GiftCard, total_cents: Int where total_cents >= 0) -> Int =
  min(card.balance_cents, total_cents)

# Whether a card fully covers a total on its own.
def card_covers(card: GiftCard, total_cents: Int where total_cents >= 0) -> Bool =
  card.balance_cents >= total_cents

# The remaining total after a card pays, paired with the drained card.
type Redemption = {remaining_total: Int, card: GiftCard}

# Apply a card to a total; neither the total nor the balance can go negative.
def apply_gift_card(total_cents: Int where total_cents >= 0, card: GiftCard) -> Redemption = {
  let spend = card_spend(card, total_cents);
  {remaining_total: total_cents - spend,
   card: GiftCard{..card, balance_cents: card.balance_cents - spend}}
}

# A one-line card summary, e.g. "GC-7: $12.50 remaining".
def card_summary(card: GiftCard) -> Text =
  card.code ++ ": " ++ format_cents(card.balance_cents) ++ " remaining"

# A cart priced then paid down by a card: the pricing, cash due, and the card.
type CardPricing = {pricing: Pricing, due: Int, card: GiftCard}

# Price a cart with price_cart, then pay as much as possible with a gift card.
def price_cart_with_card(cart: List[Line], coupons: List[Coupon], card: GiftCard) -> Result[CardPricing, Text] = {
  let p = price_cart(cart, coupons)?;
  let r = apply_gift_card(p.total, card);
  Ok({pricing: p, due: r.remaining_total, card: r.card})
}

# Whether a card can pay a cart outright once priced; unpriceable carts count as no.
def card_covers_cart(cart: List[Line], coupons: List[Coupon], card: GiftCard) -> Bool =
  match price_cart(cart, coupons) {
    Ok(p) => card_covers(card, p.total),
    Err(_) => false,
  }

# Find a gift card in a wallet by its code, if present.
def find_card(wallet: List[GiftCard], code: Text) -> Option[GiftCard] =
  find(wallet, (c: GiftCard) => c.code == code)

# Find a gift card by code, or an Err naming the missing code.
def card_or_err(wallet: List[GiftCard], code: Text) -> Result[GiftCard, Text] =
  ok_or(find_card(wallet, code), "unknown gift card: " ++ code)

# The remaining total after a whole wallet pays, paired with the updated cards.
type WalletRedemption = {remaining_total: Int, cards: List[GiftCard]}

# Apply every card in a wallet, in order, until the total is paid or cards run out.
def apply_cards(total_cents: Int where total_cents >= 0, wallet: List[GiftCard]) -> WalletRedemption =
  match wallet {
    [] => {remaining_total: total_cents, cards: wallet},
    [c, ..rest] => {
      let first = apply_gift_card(total_cents, c);
      let others = apply_cards(first.remaining_total, rest);
      {remaining_total: others.remaining_total, cards: [first.card] ++ others.cards}
    },
  }

# Total stored value in cents across a wallet of gift cards.
def total_card_value(wallet: List[GiftCard]) -> Int =
  fold(wallet, 0, (acc: Int, c: GiftCard) => acc + c.balance_cents)

# ------------------------------------------------------------
# 9. Loyalty tiers
# ------------------------------------------------------------

# The loyalty tier ladder, from base to best.
type Tier = Bronze | Silver | Gold

# The tier a lifetime points balance earns: 5000+ is Gold, 1000+ is Silver.
def tier_of(lifetime_points: Int where lifetime_points >= 0) -> Tier =
  if lifetime_points >= 5000 then Gold
  else if lifetime_points >= 1000 then Silver
  else Bronze

# A human-readable tier name.
def tier_name(t: Tier) -> Text =
  match t {
    Bronze => "bronze",
    Silver => "silver",
    Gold => "gold",
  }

# The extra percent discount a tier grants on the final total.
def tier_benefit_percent(t: Tier) -> Int =
  match t {
    Bronze => 0,
    Silver => 3,
    Gold => 7,
  }

# The tier benefit in cents on a total, using integer math.
def tier_benefit_cents(t: Tier, total_cents: Int where total_cents >= 0) -> Int =
  total_cents * tier_benefit_percent(t) / 100

# A total after its tier benefit, clamped so it can never go negative.
def apply_tier_benefit(t: Tier, total_cents: Int where total_cents >= 0) -> Int =
  clamp_total(total_cents, tier_benefit_cents(t, total_cents))

# The tier for the ledger entry of a customer; absent customers rank Bronze.
def customer_tier(ledger: List[Loyalty], customer_id: Int) -> Tier =
  tier_of(loyalty_or_new(ledger, customer_id).points)

# Price a cart, then fold the tier benefit into the discount and total.
def price_cart_for_tier(cart: List[Line], coupons: List[Coupon], t: Tier) -> Result[Pricing, Text] = {
  let p = price_cart(cart, coupons)?;
  let bonus = tier_benefit_cents(t, p.total);
  Ok({..p, discount: p.discount + bonus, total: p.total - bonus})
}

# Price a cart for a customer, using the tier their ledger entry earns.
def price_cart_for_customer(cart: List[Line], coupons: List[Coupon], ledger: List[Loyalty], customer_id: Int) -> Result[Pricing, Text] =
  price_cart_for_tier(cart, coupons, customer_tier(ledger, customer_id))

# Full checkout: a tier-priced cart paid down by a gift card.
def checkout_with_card(cart: List[Line], coupons: List[Coupon], ledger: List[Loyalty], customer_id: Int, card: GiftCard) -> Result[CardPricing, Text] = {
  let p = price_cart_for_customer(cart, coupons, ledger, customer_id)?;
  let r = apply_gift_card(p.total, card);
  Ok({pricing: p, due: r.remaining_total, card: r.card})
}

# A short tier label, e.g. "silver (3% off)".
def tier_label(t: Tier) -> Text =
  tier_name(t) ++ " (" ++ text_of_int(tier_benefit_percent(t)) ++ "% off)"

# Points still needed to reach the next tier; Gold members need none.
def points_to_next_tier(pts: Int where pts >= 0) -> Int =
  if pts >= 5000 then 0
  else if pts >= 1000 then 5000 - pts
  else 1000 - pts

# A one-line tier report: statement, current tier, and distance to the next.
def tier_report(l: Loyalty) -> Text =
  loyalty_statement(l) ++ ", " ++ tier_label(tier_of(l.points))
    ++ ", " ++ text_of_int(points_to_next_tier(l.points)) ++ " to next tier"

# A multi-line report covering every account in a loyalty ledger.
def loyalty_report(ledger: List[Loyalty]) -> Text =
  join(map(ledger, (l: Loyalty) => tier_report(l)), "\n")

# ------------------------------------------------------------
# Tests — 7. Customers & loyalty
# ------------------------------------------------------------

test "customer directory has six customers" =
  len(customers) == 6

test "find customer hit" =
  match find_customer(3) {
    Some(c) => c.name == "Cleo Ito",
    None => false,
  }

test "find customer miss" =
  find_customer(99) == None

test "find customer by email" =
  match find_customer_by_email("devi@example.com") {
    Some(c) => c.id == 4,
    None => false,
  }

test "customer or err names the id" =
  customer_or_err(99) == Err("unknown customer: 99")

test "customer display falls back to id" =
  customer_display(1) == "Ada Chen <ada@example.com>"
    and customer_display(99) == "customer #99"

test "next customer id tops the directory" =
  next_customer_id(customers) == 7 and next_customer_id([]) == 1

test "register customer grows the directory" =
  match register_customer(customers, 7, "Gus Hall", "gus@example.com") {
    Ok(dir) => len(dir) == 7 and next_customer_id(dir) == 8,
    Err(_) => false,
  }

test "register rejects duplicate ids" =
  register_customer(customers, 3, "Imposter", "i@example.com")
    == Err("duplicate customer id: 3")

test "register rejects bad emails" =
  register_customer(customers, 9, "No Email", "nope")
    == Err("invalid email: nope")

test "new loyalty starts empty" =
  new_loyalty(5) == Loyalty{customer_id: 5, points: 0}

test "one point per hundred cents" =
  points_for_total(250) == 2 and points_for_total(99) == 0

test "points never exceed their spend" (c: Int where c >= 0 and c < 10000000) = {
  let p = points_for_total(c);
  p >= 0 and p * 100 <= c
}

test "earn points credits the account" =
  earn_points(new_loyalty(1), 1250).points == 12

test "placed orders earn points" =
  points_for_order({id: 1, lines: [], state: Placed, total_cents: 2500}) == 25

test "draft orders earn nothing" =
  points_for_order({id: 1, lines: [], state: Draft, total_cents: 2500}) == 0

test "earn then redeem round-trips" (p: Int where p > 0 and p < 100000) =
  redeem_points(earn_points(new_loyalty(7), p * 100), p)
    == Ok(Loyalty{customer_id: 7, points: 0})

test "redeem points debits" =
  redeem_points(Loyalty{customer_id: 2, points: 100}, 40)
    == Ok(Loyalty{customer_id: 2, points: 60})

test "redeem reports insufficiency" =
  match redeem_points(new_loyalty(1), 5) {
    Err(m) => contains(m, "insufficient points"),
    Ok(_) => false,
  }

test "ledger earn creates a missing account" = {
  let led = ledger_earn([], 2, {id: 1, lines: [], state: Placed, total_cents: 500});
  loyalty_or_new(led, 2).points == 5
}

test "ledger earn updates an existing account" = {
  let once = ledger_earn([], 2, {id: 1, lines: [], state: Shipped, total_cents: 700});
  let twice = ledger_earn(once, 2, {id: 2, lines: [], state: Shipped, total_cents: 700});
  twice == [Loyalty{customer_id: 2, points: 14}]
}

test "ledger points totals every account" =
  ledger_points([Loyalty{customer_id: 1, points: 10}, Loyalty{customer_id: 2, points: 32}]) == 42

test "ledger redeem needs an account" =
  match ledger_redeem([], 9, 5) {
    Err(m) => contains(m, "no loyalty account"),
    Ok(_) => false,
  }

test "ledger redeem debits in place" =
  ledger_redeem([Loyalty{customer_id: 4, points: 50}], 4, 20)
    == Ok([Loyalty{customer_id: 4, points: 30}])

test "loyalty statement shows cash value" = {
  let s = loyalty_statement(Loyalty{customer_id: 1, points: 150});
  contains(s, "Ada Chen") and contains(s, "$1.50")
}

test "placing an order feeds the ledger" =
  match place_order(new_order(9, add_to_cart([], "POT-001", 2)), initial_stock, []) {
    Ok(pl) => loyalty_or_new(ledger_earn([], 1, pl.order), 1).points
      == points_for_total(pl.order.total_cents),
    Err(_) => false,
  }

# ------------------------------------------------------------
# Tests — 8. Gift cards
# ------------------------------------------------------------

test "issue gift card holds its balance" =
  issue_gift_card("GC-1", 2500) == GiftCard{code: "GC-1", balance_cents: 2500}

test "top up adds value" =
  top_up(issue_gift_card("GC-1", 1000), 500).balance_cents == 1500

test "partial card leaves a due total" =
  apply_gift_card(5000, issue_gift_card("GC-1", 2000))
    == {remaining_total: 3000, card: GiftCard{code: "GC-1", balance_cents: 0}}

test "rich card clears the total" = {
  let r = apply_gift_card(1500, issue_gift_card("GC-2", 2000));
  r.remaining_total == 0 and r.card.balance_cents == 500
}

test "card application never goes negative" (t: Int where t >= 0 and t < 10000000, b: Int where b >= 0 and b < 10000000) = {
  let r = apply_gift_card(t, issue_gift_card("P", b));
  r.remaining_total >= 0 and r.card.balance_cents >= 0
}

test "card application conserves money" (t: Int where t >= 0 and t < 10000000, b: Int where b >= 0 and b < 10000000) = {
  let r = apply_gift_card(t, issue_gift_card("P", b));
  t - r.remaining_total == b - r.card.balance_cents
}

test "card covers exact totals" =
  card_covers(issue_gift_card("GC", 1000), 1000)
    and not card_covers(issue_gift_card("GC", 999), 1000)

test "card summary uses money formatting" =
  card_summary(issue_gift_card("GC-7", 1250)) == "GC-7: $12.50 remaining"

test "find card by code" =
  match find_card([issue_gift_card("A", 1), issue_gift_card("B", 2)], "B") {
    Some(c) => c.balance_cents == 2,
    None => false,
  }

test "card or err names the code" =
  card_or_err([], "GHOST") == Err("unknown gift card: GHOST")

test "price cart with card computes cash due" =
  price_cart_with_card(add_to_cart([], "TEA-001", 2), [], issue_gift_card("GC-9", 1000))
    == Ok({pricing: {subtotal: 2500, discount: 0, shipping: 500, total: 3000},
           due: 2000, card: GiftCard{code: "GC-9", balance_cents: 0}})

test "price cart with card propagates sku errors" =
  price_cart_with_card([{sku: "NOPE", qty: 1}], [], issue_gift_card("GC", 100))
    == Err("unknown sku: NOPE")

test "card covers cart checks the priced total" =
  card_covers_cart(add_to_cart([], "HNY-001", 1), [], issue_gift_card("BIG", 100000))
    and not card_covers_cart(add_to_cart([], "HNY-001", 1), [], issue_gift_card("SMALL", 100))

test "wallet spends cards in order" =
  apply_cards(3000, [issue_gift_card("A", 1000), issue_gift_card("B", 5000)])
    == {remaining_total: 0,
        cards: [GiftCard{code: "A", balance_cents: 0}, GiftCard{code: "B", balance_cents: 3000}]}

test "empty wallet changes nothing" = {
  let r = apply_cards(4200, []);
  r.remaining_total == 4200 and len(r.cards) == 0
}

test "wallet application conserves money" (t: Int where t >= 0 and t < 10000000, bs: List[Int]) = {
  let wallet = map(bs, (b: Int) => issue_gift_card("W", max(0, b) % 1000000));
  let r = apply_cards(t, wallet);
  t - r.remaining_total == total_card_value(wallet) - total_card_value(r.cards)
}

test "total card value sums balances" =
  total_card_value([issue_gift_card("A", 100), issue_gift_card("B", 250)]) == 350

# ------------------------------------------------------------
# Tests — 9. Loyalty tiers
# ------------------------------------------------------------

test "tier ladder thresholds" =
  tier_of(0) == Bronze and tier_of(999) == Bronze
    and tier_of(1000) == Silver and tier_of(4999) == Silver
    and tier_of(5000) == Gold

test "tier names read cleanly" =
  tier_name(Bronze) == "bronze" and tier_name(Silver) == "silver" and tier_name(Gold) == "gold"

test "tier benefit percents climb the ladder" =
  tier_benefit_percent(Bronze) == 0
    and tier_benefit_percent(Silver) == 3
    and tier_benefit_percent(Gold) == 7

test "tier benefit uses integer math" =
  tier_benefit_cents(Gold, 10000) == 700 and tier_benefit_cents(Silver, 999) == 29

test "tier benefit stays within the total" (t: Int where t >= 0 and t < 10000000) = {
  let b = tier_benefit_cents(Gold, t);
  b >= 0 and b <= t
}

test "bronze benefit is the identity" (t: Int where t >= 0 and t < 10000000) =
  apply_tier_benefit(Bronze, t) == t

test "earning points never lowers the tier" (p: Int where p >= 0 and p < 100000, e: Int where e >= 0 and e < 100000) =
  tier_benefit_percent(tier_of(p + e)) >= tier_benefit_percent(tier_of(p))

test "customer tier reads the ledger" =
  customer_tier([Loyalty{customer_id: 3, points: 6000}], 3) == Gold
    and customer_tier([], 3) == Bronze

test "gold pricing folds the benefit into the total" =
  price_cart_for_tier(add_to_cart([], "TEA-001", 2), [], Gold)
    == Ok({subtotal: 2500, discount: 210, shipping: 500, total: 2790})

test "bronze pricing matches plain pricing" =
  price_cart_for_tier(add_to_cart([], "POT-001", 2), [], Bronze)
    == price_cart(add_to_cart([], "POT-001", 2), [])

test "customer pricing uses the ledger tier" =
  price_cart_for_customer(add_to_cart([], "TEA-001", 2), [], [Loyalty{customer_id: 1, points: 6000}], 1)
    == price_cart_for_tier(add_to_cart([], "TEA-001", 2), [], Gold)

test "checkout stacks tier and gift card" =
  checkout_with_card(add_to_cart([], "TEA-001", 2), [], [Loyalty{customer_id: 1, points: 6000}], 1, issue_gift_card("GC-5", 1000))
    == Ok({pricing: {subtotal: 2500, discount: 210, shipping: 500, total: 2790},
           due: 1790, card: GiftCard{code: "GC-5", balance_cents: 0}})

test "checkout propagates pricing errors" =
  match checkout_with_card([{sku: "NOPE", qty: 1}], [], [], 1, issue_gift_card("GC", 100)) {
    Err(m) => contains(m, "unknown sku"),
    Ok(_) => false,
  }

test "tier label shows the percent" =
  tier_label(Silver) == "silver (3% off)"

test "points to next tier counts down" =
  points_to_next_tier(0) == 1000
    and points_to_next_tier(1200) == 3800
    and points_to_next_tier(5000) == 0

test "tier report combines statement and ladder" = {
  let r = tier_report(Loyalty{customer_id: 2, points: 1500});
  contains(r, "Bram Osei") and contains(r, "silver") and contains(r, "3500 to next tier")
}

test "loyalty report lists every account" = {
  let r = loyalty_report([Loyalty{customer_id: 1, points: 100}, Loyalty{customer_id: 5, points: 6000}]);
  contains(r, "Ada Chen") and contains(r, "Emil Novak") and contains(r, "gold")
}

# ------------------------------------------------------------
# 10. Wallet & ledger summaries
# ------------------------------------------------------------

# A multi-line summary of every card in a wallet.
def wallet_summary(wallet: List[GiftCard]) -> Text =
  join(map(wallet, (c: GiftCard) => card_summary(c)), "\n")

# How many ledger accounts currently sit at a given tier.
def count_tier(ledger: List[Loyalty], t: Tier) -> Int =
  len(filter(ledger, (l: Loyalty) => tier_of(l.points) == t))

# The card holding the most value; ties keep the earlier card.
def richest_card(wallet: List[GiftCard]) -> Option[GiftCard] =
  list_get(sort_by(wallet, (c: GiftCard) => 0 - c.balance_cents), 0)

# The points discount an account can put toward a total, capped at the total.
def points_discount(l: Loyalty, total_cents: Int where total_cents >= 0) -> Int =
  min(points_value_cents(l.points), total_cents)

# The remaining total after points pay, paired with the debited account.
type PointsRedemption = {remaining_total: Int, account: Loyalty}

# Pay a total with loyalty points; neither total nor balance can go negative.
def apply_points(l: Loyalty, total_cents: Int where total_cents >= 0) -> PointsRedemption = {
  let spend = points_discount(l, total_cents);
  {remaining_total: total_cents - spend,
   account: Loyalty{..l, points: l.points - spend}}
}

# ------------------------------------------------------------
# Tests — 10. Wallet & ledger summaries
# ------------------------------------------------------------

test "wallet summary lists each card" = {
  let s = wallet_summary([issue_gift_card("A", 100), issue_gift_card("B", 2500)]);
  contains(s, "A: $1.00") and contains(s, "B: $25.00")
}

test "count tier tallies the ledger" = {
  let led = [Loyalty{customer_id: 1, points: 0},
             Loyalty{customer_id: 2, points: 1500},
             Loyalty{customer_id: 3, points: 9000}];
  count_tier(led, Bronze) == 1 and count_tier(led, Silver) == 1 and count_tier(led, Gold) == 1
}

test "richest card wins" =
  richest_card([issue_gift_card("A", 100), issue_gift_card("B", 900), issue_gift_card("C", 50)])
    == Some(GiftCard{code: "B", balance_cents: 900})

test "richest card of empty wallet is None" =
  richest_card([]) == None

test "points discount caps at the total" =
  points_discount(Loyalty{customer_id: 1, points: 500}, 300) == 300
    and points_discount(Loyalty{customer_id: 1, points: 200}, 300) == 200

test "apply points drains and pays" =
  apply_points(Loyalty{customer_id: 6, points: 400}, 1000)
    == {remaining_total: 600, account: Loyalty{customer_id: 6, points: 0}}

test "points application never overdraws" (p: Int where p >= 0 and p < 1000000, t: Int where t >= 0 and t < 1000000) = {
  let r = apply_points(Loyalty{customer_id: 1, points: p}, t);
  r.remaining_total >= 0 and r.account.points >= 0
    and t - r.remaining_total == p - r.account.points
}

# ------------------------------------------------------------
# 11. Taxes
# ------------------------------------------------------------

# The tax zone an order is billed under.
type TaxZone = NoTax | Reduced | Standard

# The tax rate percent a zone charges: exempt 0, reduced 5, standard 8.
def tax_rate_percent(z: TaxZone) -> Int =
  match z {
    NoTax => 0,
    Reduced => 5,
    Standard => 8,
  }

# A human-readable name for a tax zone.
def tax_zone_name(z: TaxZone) -> Text =
  match z {
    NoTax => "no tax",
    Reduced => "reduced",
    Standard => "standard",
  }

# Parse a zone label like "standard" into a TaxZone, if recognised.
def parse_zone(code: Text) -> Option[TaxZone] =
  match trim(to_lower(code)) {
    "none" => Some(NoTax),
    "reduced" => Some(Reduced),
    "standard" => Some(Standard),
    _ => None,
  }

# The tax in cents a zone charges on a taxable amount, using integer math.
def tax_on(z: TaxZone, taxable_cents: Int where taxable_cents >= 0) -> Int =
  taxable_cents * tax_rate_percent(z) / 100

# The taxable part of a pricing: the post-discount, pre-shipping amount.
def taxable_amount(p: Pricing) -> Int =
  max(0, p.total - p.shipping)

# The tax a zone charges on a priced cart's taxable amount.
def tax_of_pricing(z: TaxZone, p: Pricing) -> Int =
  tax_on(z, taxable_amount(p))

# Whether a zone levies any tax at all.
def is_taxed(z: TaxZone) -> Bool =
  tax_rate_percent(z) > 0

# The tax-inclusive total an existing Pricing reaches under a zone.
def tax_inclusive_total(p: Pricing, z: TaxZone) -> Int =
  p.total + tax_of_pricing(z, p)

# A taxed pricing: the Pricing story plus tax and a tax-inclusive grand total.
type TaxedPricing = {subtotal: Int, discount: Int, shipping: Int, tax: Int, grand_total: Int}

# Price a cart with price_cart, then add zone tax on the taxable amount.
def price_cart_taxed(cart: List[Line], coupons: List[Coupon], zone: TaxZone) -> Result[TaxedPricing, Text] = {
  let p = price_cart(cart, coupons)?;
  let tax = tax_of_pricing(zone, p);
  Ok({subtotal: p.subtotal, discount: p.discount, shipping: p.shipping,
      tax: tax, grand_total: p.total + tax})
}

# A receipt-style tax summary row, e.g. "  tax (standard 8%): $2.00".
def tax_row(zone: TaxZone, tax_cents: Int where tax_cents >= 0) -> Text =
  money_row("tax (" ++ tax_zone_name(zone) ++ " "
    ++ text_of_int(tax_rate_percent(zone)) ++ "%)", tax_cents)

# A full multi-line receipt for an order priced with zone tax.
def taxed_receipt(o: Order, coupons: List[Coupon], zone: TaxZone) -> Text =
  match price_cart_taxed(o.lines, coupons, zone) {
    Ok(tp) => join(
      ["=== order #" ++ text_of_int(o.id) ++ " (" ++ state_name(o.state) ++ ") ==="]
        ++ map(o.lines, (l: Line) => receipt_row(l))
        ++ [money_row("subtotal", tp.subtotal),
            money_row("discount", tp.discount),
            money_row("Shipping", tp.shipping),
            tax_row(zone, tp.tax),
            money_row("grand total", tp.grand_total)],
      "\n"),
    Err(e) => "receipt error: " ++ e,
  }

# ------------------------------------------------------------
# 12. Shipping zones
# ------------------------------------------------------------

# The shipping region an order travels to.
type Region = Domestic | Nearby | Overseas

# A human-readable name for a shipping region.
def region_name(r: Region) -> Text =
  match r {
    Domestic => "domestic",
    Nearby => "nearby",
    Overseas => "overseas",
  }

# Parse a region label like "overseas" into a Region, if recognised.
def parse_region(code: Text) -> Option[Region] =
  match trim(to_lower(code)) {
    "domestic" => Some(Domestic),
    "nearby" => Some(Nearby),
    "overseas" => Some(Overseas),
    _ => None,
  }

# The per-region surcharge in cents on top of the flat shipping fee.
def region_surcharge(r: Region) -> Int =
  match r {
    Domestic => 0,
    Nearby => 400,
    Overseas => 1200,
  }

# The shipping fee for a region: flat fee plus surcharge, still waived at 30000c.
def regional_shipping_fee(r: Region, discounted_cents: Int where discounted_cents >= 0) -> Int = {
  let base = shipping_fee(discounted_cents);
  if base == 0 then 0 else base + region_surcharge(r)
}

# Roughly how many days delivery to a region takes.
def delivery_days(r: Region) -> Int =
  match r {
    Domestic => 2,
    Nearby => 5,
    Overseas => 12,
  }

# A receipt-style delivery estimate line for a region.
def delivery_note(r: Region) -> Text =
  "  " ++ region_name(r) ++ " delivery in about "
    ++ text_of_int(delivery_days(r)) ++ " days"

# All shipping regions, from nearest to farthest.
def all_regions: List[Region] =
  [Domestic, Nearby, Overseas]

# Whether the shipping fee (and so any surcharge) is waived for this amount.
def surcharge_waived(discounted_cents: Int where discounted_cents >= 0) -> Bool =
  shipping_fee(discounted_cents) == 0

# A receipt-style shipping row naming the region.
def shipping_row(r: Region, fee_cents: Int where fee_cents >= 0) -> Text =
  money_row("shipping (" ++ region_name(r) ++ ")", fee_cents)

# A multi-line menu pricing every region's fee for a given discounted amount.
def shipping_options(discounted_cents: Int where discounted_cents >= 0) -> Text =
  join(map(all_regions, (r: Region) =>
    shipping_row(r, regional_shipping_fee(r, discounted_cents))), "\n")

# Price a taxed cart for a region, adding the surcharge unless shipping is waived.
def price_cart_regional(cart: List[Line], coupons: List[Coupon], zone: TaxZone, region: Region) -> Result[TaxedPricing, Text] = {
  let tp = price_cart_taxed(cart, coupons, zone)?;
  let extra = if tp.shipping == 0 then 0 else region_surcharge(region);
  Ok({..tp, shipping: tp.shipping + extra, grand_total: tp.grand_total + extra})
}

# A full multi-line receipt for an order priced with zone tax and a region.
def regional_receipt(o: Order, coupons: List[Coupon], zone: TaxZone, region: Region) -> Text =
  match price_cart_regional(o.lines, coupons, zone, region) {
    Ok(tp) => join(
      ["=== order #" ++ text_of_int(o.id) ++ " to " ++ region_name(region) ++ " ==="]
        ++ map(o.lines, (l: Line) => receipt_row(l))
        ++ [money_row("subtotal", tp.subtotal),
            money_row("discount", tp.discount),
            shipping_row(region, tp.shipping),
            tax_row(zone, tp.tax),
            money_row("grand total", tp.grand_total),
            delivery_note(region)],
      "\n"),
    Err(e) => "receipt error: " ++ e,
  }

# ------------------------------------------------------------
# 13. Returns & refunds
# ------------------------------------------------------------

# Why a shopper is returning an order.
type ReturnReason = Defective | Unwanted

# A human-readable name for a return reason.
def return_reason_name(r: ReturnReason) -> Text =
  match r {
    Defective => "defective",
    Unwanted => "unwanted",
  }

# A refund; the [W42] invariant keeps both amounts non-negative.
type Refund = {order_id: Int, amount_cents: Int, fee_cents: Int} where amount_cents >= 0 and fee_cents >= 0

# The restocking percent a return reason costs: defective free, unwanted 10.
def restocking_percent(reason: ReturnReason) -> Int =
  match reason {
    Defective => 0,
    Unwanted => 10,
  }

# The restocking percent a return reason costs for a loyalty tier:
# defective is always free; unwanted costs 10, waived entirely for Gold.
def restocking_percent_for(reason: ReturnReason, t: Tier) -> Int =
  match reason {
    Defective => 0,
    Unwanted => match t {
      Gold => 0,
      _ => restocking_percent(Unwanted),
    },
  }

# The restocking fee in cents on a gross refund for a loyalty tier, using integer math.
def restocking_fee_for(gross_cents: Int where gross_cents >= 0, reason: ReturnReason, t: Tier) -> Int =
  gross_cents * restocking_percent_for(reason, t) / 100

# The restocking fee in cents on a gross refund, using integer math.
def restocking_fee(gross_cents: Int where gross_cents >= 0, reason: ReturnReason) -> Int =
  restocking_fee_for(gross_cents, reason, Bronze)

# Whether an order's state allows a refund: only Placed or Shipped qualify.
def refund_eligible(o: Order) -> Bool =
  match o.state {
    Placed => true,
    Shipped => true,
    Draft => false,
    Cancelled => false,
  }

# Compute the refund an order, reason, and loyalty tier earn, or Err for ineligible states.
# Gold members pay no restocking fee on unwanted returns.
def compute_refund_for(o: Order, reason: ReturnReason, t: Tier) -> Result[Refund, Text] =
  if not refund_eligible(o)
  then Err("no refund for " ++ state_name(o.state) ++ " order #" ++ text_of_int(o.id))
  else {
    let gross = order_revenue(o);
    let fee = restocking_fee_for(gross, reason, t);
    Ok(Refund{order_id: o.id, amount_cents: gross - fee, fee_cents: fee})
  }

# Compute the refund an order and reason earn, or Err for ineligible states.
def compute_refund(o: Order, reason: ReturnReason) -> Result[Refund, Text] =
  compute_refund_for(o, reason, Bronze)

# The result of processing a return: the refund, the order, restored inventory.
type RefundOutcome = {refund: Refund, order: Order, inv: List[Stock]}

# Process a return for a loyalty tier: refund the order and restock its lines; Placed orders cancel.
def process_return_for(o: Order, inv: List[Stock], reason: ReturnReason, t: Tier) -> Result[RefundOutcome, Text] = {
  let rf = compute_refund_for(o, reason, t)?;
  match o.state {
    Placed => {
      let pl = cancel_and_restock(o, inv)?;
      Ok({refund: rf, order: pl.order, inv: pl.inv})
    },
    _ => {
      let restored = restock_lines(inv, o.lines)?;
      Ok({refund: rf, order: o, inv: restored})
    },
  }
}

# Process a return: refund the order and restock its lines; Placed orders cancel.
def process_return(o: Order, inv: List[Stock], reason: ReturnReason) -> Result[RefundOutcome, Text] =
  process_return_for(o, inv, reason, Bronze)

# The gross amount a refund covers before its restocking fee.
def gross_refund(rf: Refund) -> Int =
  rf.amount_cents + rf.fee_cents

# Total cents paid back across a list of refunds.
def total_refunded(rfs: List[Refund]) -> Int =
  fold(rfs, 0, (acc: Int, r: Refund) => acc + r.amount_cents)

# Total restocking fees kept across a list of refunds.
def total_restocking_fees(rfs: List[Refund]) -> Int =
  fold(rfs, 0, (acc: Int, r: Refund) => acc + r.fee_cents)

# Revenue across orders minus everything refunded, never below zero.
def net_revenue_after_refunds(orders: List[Order], rfs: List[Refund]) -> Int =
  max(0, total_revenue(orders) - total_refunded(rfs))

# Refund every eligible order in a batch at a loyalty tier, skipping ineligible ones.
def refund_all_for(orders: List[Order], reason: ReturnReason, t: Tier) -> List[Refund] =
  match orders {
    [] => [],
    [o, ..rest] => match compute_refund_for(o, reason, t) {
      Ok(rf) => [rf] ++ refund_all_for(rest, reason, t),
      Err(_) => refund_all_for(rest, reason, t),
    },
  }

# Refund every eligible order in a batch, skipping ineligible ones.
def refund_all(orders: List[Order], reason: ReturnReason) -> List[Refund] =
  refund_all_for(orders, reason, Bronze)

# Whether a refund kept any restocking fee at all.
def kept_a_fee(rf: Refund) -> Bool =
  rf.fee_cents > 0

# The refunds in a batch that kept a restocking fee.
def refunds_with_fees(rfs: List[Refund]) -> List[Refund] =
  filter(rfs, (r: Refund) => kept_a_fee(r))

# A multi-line refund statement reusing the receipt money rows.
def refund_statement(rf: Refund) -> Text =
  join(["=== refund for order #" ++ text_of_int(rf.order_id) ++ " ===",
        money_row("gross", gross_refund(rf)),
        money_row("restocking fee", rf.fee_cents),
        money_row("refunded", rf.amount_cents)],
    "\n")

# A two-line summary of a refund batch: paid back and fees kept.
def refund_summary(rfs: List[Refund]) -> Text =
  join([money_row("total refunded", total_refunded(rfs)),
        money_row("fees kept", total_restocking_fees(rfs))],
    "\n")

# ------------------------------------------------------------
# Tests — 11. Taxes
# ------------------------------------------------------------

test "tax rates ladder" =
  tax_rate_percent(NoTax) == 0
    and tax_rate_percent(Reduced) == 5
    and tax_rate_percent(Standard) == 8

test "tax zone names read cleanly" =
  tax_zone_name(NoTax) == "no tax"
    and tax_zone_name(Reduced) == "reduced"
    and tax_zone_name(Standard) == "standard"

test "parse zone recognises labels" =
  parse_zone("standard") == Some(Standard)
    and parse_zone("  Reduced ") == Some(Reduced)
    and parse_zone("none") == Some(NoTax)
    and parse_zone("martian") == None

test "parse zone round-trips names except no tax" =
  parse_zone(tax_zone_name(Reduced)) == Some(Reduced)
    and parse_zone(tax_zone_name(Standard)) == Some(Standard)

test "tax on uses integer math" =
  tax_on(Standard, 999) == 79 and tax_on(Reduced, 999) == 49

test "no tax zone charges nothing" (n: Int where n >= 0 and n < 10000000) =
  tax_on(NoTax, n) == 0

test "tax never exceeds its base" (n: Int where n >= 0 and n < 10000000) = {
  let t = tax_on(Standard, n);
  t >= 0 and t <= n
}

test "taxable amount excludes shipping" =
  taxable_amount({subtotal: 2500, discount: 0, shipping: 500, total: 3000}) == 2500

test "price cart taxed extends price cart" =
  price_cart_taxed(add_to_cart([], "TEA-001", 2), [], Standard)
    == Ok({subtotal: 2500, discount: 0, shipping: 500, tax: 200, grand_total: 3200})

test "no tax grand total matches plain pricing" =
  match price_cart(add_to_cart([], "TEA-001", 2), []) {
    Ok(p) => price_cart_taxed(add_to_cart([], "TEA-001", 2), [], NoTax)
      == Ok({subtotal: p.subtotal, discount: p.discount, shipping: p.shipping,
             tax: 0, grand_total: p.total}),
    Err(_) => false,
  }

test "tax is computed after discounts" =
  price_cart_taxed(add_to_cart([], "POT-001", 2), [make_coupon("POT-001", 10)], Standard)
    == Ok({subtotal: 12800, discount: 1920, shipping: 500, tax: 870, grand_total: 12250})

test "price cart taxed propagates sku errors" =
  price_cart_taxed([{sku: "NOPE", qty: 1}], [], Standard)
    == Err("unknown sku: NOPE")

test "tax row names the zone and rate" =
  tax_row(Standard, 200) == "  tax (standard 8%): $2.00"

test "taxed receipt shows tax and grand total" = {
  let r = taxed_receipt(new_order(41, add_to_cart([], "TEA-001", 2)), [], Standard);
  contains(r, "Green Tea Tin")
    and contains(r, "tax (standard 8%): $2.00")
    and contains(r, "grand total: $32.00")
}

test "taxed receipt reports sku errors" =
  contains(taxed_receipt(new_order(42, [{sku: "NOPE", qty: 1}]), [], Standard), "receipt error")

test "only the no tax zone is untaxed" =
  not is_taxed(NoTax) and is_taxed(Reduced) and is_taxed(Standard)

test "tax inclusive total agrees with taxed pricing" =
  match price_cart(add_to_cart([], "KTL-001", 1), []) {
    Ok(p) => match price_cart_taxed(add_to_cart([], "KTL-001", 1), [], Standard) {
      Ok(tp) => tax_inclusive_total(p, Standard) == tp.grand_total,
      Err(_) => false,
    },
    Err(_) => false,
  }

# ------------------------------------------------------------
# Tests — 12. Shipping zones
# ------------------------------------------------------------

test "region surcharges ladder" =
  region_surcharge(Domestic) == 0
    and region_surcharge(Nearby) == 400
    and region_surcharge(Overseas) == 1200

test "region names read cleanly" =
  region_name(Domestic) == "domestic"
    and region_name(Nearby) == "nearby"
    and region_name(Overseas) == "overseas"

test "parse region round-trips every name" =
  parse_region(region_name(Domestic)) == Some(Domestic)
    and parse_region(region_name(Nearby)) == Some(Nearby)
    and parse_region(region_name(Overseas)) == Some(Overseas)
    and parse_region("lunar") == None

test "regional fee adds the surcharge below threshold" =
  regional_shipping_fee(Overseas, 10000) == 1700
    and regional_shipping_fee(Nearby, 10000) == 900

test "regional fee waived entirely at threshold" =
  regional_shipping_fee(Overseas, 30000) == 0
    and regional_shipping_fee(Nearby, 30000) == 0
    and regional_shipping_fee(Domestic, 30000) == 0

test "domestic fee matches the flat fee" (d: Int where d >= 0 and d < 10000000) =
  regional_shipping_fee(Domestic, d) == shipping_fee(d)

test "regional fee never undercuts the flat fee" (d: Int where d >= 0 and d < 10000000) =
  regional_shipping_fee(Overseas, d) >= shipping_fee(d)
    and regional_shipping_fee(Nearby, d) >= shipping_fee(d)

test "regional pricing adds the surcharge" =
  price_cart_regional(add_to_cart([], "TEA-001", 2), [], Standard, Overseas)
    == Ok({subtotal: 2500, discount: 0, shipping: 1700, tax: 200, grand_total: 4400})

test "regional pricing waives the surcharge above threshold" =
  price_cart_regional(add_to_cart([], "POT-001", 5), [], Standard, Overseas)
    == Ok({subtotal: 32000, discount: 1600, shipping: 0, tax: 2432, grand_total: 32832})

test "domestic regional pricing matches taxed pricing" =
  price_cart_regional(add_to_cart([], "MUG-001", 1), [], Reduced, Domestic)
    == price_cart_taxed(add_to_cart([], "MUG-001", 1), [], Reduced)

test "surcharge never changes the tax" =
  match price_cart_regional(add_to_cart([], "TEA-002", 3), [], Standard, Overseas) {
    Ok(far) => match price_cart_taxed(add_to_cart([], "TEA-002", 3), [], Standard) {
      Ok(near) => far.tax == near.tax and far.subtotal == near.subtotal,
      Err(_) => false,
    },
    Err(_) => false,
  }

test "regional pricing propagates sku errors" =
  price_cart_regional([{sku: "NOPE", qty: 1}], [], Reduced, Nearby)
    == Err("unknown sku: NOPE")

test "delivery days climb with distance" =
  delivery_days(Domestic) == 2
    and delivery_days(Nearby) == 5
    and delivery_days(Overseas) == 12

test "shipping row names the region" =
  shipping_row(Nearby, 900) == "  shipping (nearby): $9.00"

test "regional receipt shows region and delivery" = {
  let r = regional_receipt(new_order(51, add_to_cart([], "TEA-001", 2)), [], Standard, Overseas);
  contains(r, "to overseas")
    and contains(r, "shipping (overseas): $17.00")
    and contains(r, "grand total: $44.00")
    and contains(r, "overseas delivery in about 12 days")
}

test "all regions lists the ladder in order" =
  all_regions == [Domestic, Nearby, Overseas]

test "surcharge waived tracks the flat fee" (d: Int where d >= 0 and d < 10000000) =
  surcharge_waived(d) == (shipping_fee(d) == 0)

test "shipping options menu prices every region" = {
  let m = shipping_options(10000);
  contains(m, "shipping (domestic): $5.00")
    and contains(m, "shipping (nearby): $9.00")
    and contains(m, "shipping (overseas): $17.00")
}

# ------------------------------------------------------------
# Tests — 13. Returns & refunds
# ------------------------------------------------------------

test "return reason names read cleanly" =
  return_reason_name(Defective) == "defective"
    and return_reason_name(Unwanted) == "unwanted"

test "restocking percent by reason" =
  restocking_percent(Defective) == 0 and restocking_percent(Unwanted) == 10

test "defective returns are fee-free" (g: Int where g >= 0 and g < 10000000) =
  restocking_fee(g, Defective) == 0

test "restocking fee stays within the gross" (g: Int where g >= 0 and g < 10000000) = {
  let f = restocking_fee(g, Unwanted);
  f >= 0 and f <= g
}

test "refund eligibility follows the order state" =
  refund_eligible({id: 1, lines: [], state: Placed, total_cents: 100})
    and refund_eligible({id: 1, lines: [], state: Shipped, total_cents: 100})
    and not refund_eligible({id: 1, lines: [], state: Draft, total_cents: 100})
    and not refund_eligible({id: 1, lines: [], state: Cancelled, total_cents: 100})

test "defective refund is the full amount" =
  compute_refund({id: 7, lines: [], state: Placed, total_cents: 5000}, Defective)
    == Ok(Refund{order_id: 7, amount_cents: 5000, fee_cents: 0})

test "unwanted refund deducts ten percent" =
  compute_refund({id: 8, lines: [], state: Shipped, total_cents: 5550}, Unwanted)
    == Ok(Refund{order_id: 8, amount_cents: 4995, fee_cents: 555})

test "draft orders cannot be refunded" =
  match compute_refund({id: 9, lines: [], state: Draft, total_cents: 100}, Defective) {
    Err(m) => contains(m, "no refund"),
    Ok(_) => false,
  }

test "cancelled orders cannot be refunded" =
  match compute_refund({id: 10, lines: [], state: Cancelled, total_cents: 100}, Unwanted) {
    Err(m) => contains(m, "no refund"),
    Ok(_) => false,
  }

test "refund conserves the order total" (t: Int where t >= 0 and t < 10000000) =
  match compute_refund({id: 1, lines: [], state: Placed, total_cents: t}, Unwanted) {
    Ok(rf) => gross_refund(rf) == t and rf.amount_cents >= 0 and rf.fee_cents >= 0,
    Err(_) => false,
  }

test "processing a placed return restores inventory" =
  match place_order(new_order(61, add_to_cart([], "KTL-001", 2)), initial_stock, []) {
    Ok(pl) => match process_return(pl.order, pl.inv, Defective) {
      Ok(out) => out.inv == initial_stock
        and out.order.state == Cancelled
        and out.refund == Refund{order_id: 61, amount_cents: pl.order.total_cents, fee_cents: 0},
      Err(_) => false,
    },
    Err(_) => false,
  }

test "a shipped return keeps the order shipped" =
  match place_order(new_order(62, add_to_cart([], "MUG-001", 2)), initial_stock, []) {
    Ok(pl) => match ship_order(pl.order) {
      Ok(sh) => match process_return(sh, pl.inv, Unwanted) {
        Ok(out) => out.inv == initial_stock
          and out.order.state == Shipped
          and out.refund == Refund{order_id: 62, amount_cents: 3690, fee_cents: 410},
        Err(_) => false,
      },
      Err(_) => false,
    },
    Err(_) => false,
  }

test "a cancelled order cannot be returned twice" =
  match place_order(new_order(63, add_to_cart([], "HNY-001", 1)), initial_stock, []) {
    Ok(pl) => match process_return(pl.order, pl.inv, Unwanted) {
      Ok(out) => match process_return(out.order, out.inv, Unwanted) {
        Err(m) => contains(m, "no refund for cancelled"),
        Ok(_) => false,
      },
      Err(_) => false,
    },
    Err(_) => false,
  }

test "refund totals split amounts and fees" = {
  let rfs = [Refund{order_id: 1, amount_cents: 900, fee_cents: 100},
             Refund{order_id: 2, amount_cents: 450, fee_cents: 50}];
  total_refunded(rfs) == 1350 and total_restocking_fees(rfs) == 150
}

test "net revenue subtracts refunds" =
  net_revenue_after_refunds(
    [{id: 1, lines: [], state: Placed, total_cents: 10000},
     {id: 2, lines: [], state: Draft, total_cents: 9999}],
    [Refund{order_id: 1, amount_cents: 3000, fee_cents: 0}]) == 7000

test "net revenue never goes negative" =
  net_revenue_after_refunds([],
    [Refund{order_id: 1, amount_cents: 3000, fee_cents: 0}]) == 0

test "refund statement formats every row" = {
  let s = refund_statement(Refund{order_id: 8, amount_cents: 4995, fee_cents: 555});
  contains(s, "refund for order #8")
    and contains(s, "gross: $55.50")
    and contains(s, "restocking fee: $5.55")
    and contains(s, "refunded: $49.95")
}

test "refund summary totals the batch" = {
  let s = refund_summary([Refund{order_id: 1, amount_cents: 900, fee_cents: 100},
                          Refund{order_id: 2, amount_cents: 450, fee_cents: 50}]);
  contains(s, "total refunded: $13.50") and contains(s, "fees kept: $1.50")
}

test "refund all skips ineligible orders" =
  refund_all(
    [{id: 1, lines: [], state: Placed, total_cents: 1000},
     {id: 2, lines: [], state: Draft, total_cents: 1000},
     {id: 3, lines: [], state: Shipped, total_cents: 2000}], Defective)
    == [Refund{order_id: 1, amount_cents: 1000, fee_cents: 0},
        Refund{order_id: 3, amount_cents: 2000, fee_cents: 0}]

test "defective batch refunds match total revenue" = {
  let orders = [{id: 1, lines: [], state: Placed, total_cents: 1234},
                {id: 2, lines: [], state: Shipped, total_cents: 4321},
                {id: 3, lines: [], state: Cancelled, total_cents: 999}];
  total_refunded(refund_all(orders, Defective)) == total_revenue(orders)
}

test "refunds with fees keeps only fee-bearing refunds" = {
  let rfs = [Refund{order_id: 1, amount_cents: 900, fee_cents: 100},
             Refund{order_id: 2, amount_cents: 500, fee_cents: 0}];
  refunds_with_fees(rfs) == [Refund{order_id: 1, amount_cents: 900, fee_cents: 100}]
}

test "gross refund reassembles amount and fee" =
  gross_refund(Refund{order_id: 3, amount_cents: 4995, fee_cents: 555}) == 5550

# ------------------------------------------------------------
# 14. Suppliers & purchase orders
# ------------------------------------------------------------

# A wholesale supplier: an id, a display name, and typical lead time in days.
type Supplier = {id: Int, name: Text, lead_days: Int}

# The supplier directory for the demo store.
def suppliers: List[Supplier] = [
  {id: 1, name: "Leaf & Co", lead_days: 7},
  {id: 2, name: "Kiln Works", lead_days: 21},
  {id: 3, name: "Meadow Apiary", lead_days: 10},
  {id: 4, name: "Ironline Metals", lead_days: 30}
]

# Find a supplier by id with stdlib find; None when the id is unknown.
def find_supplier(id: Int) -> Option[Supplier] =
  find(suppliers, (s: Supplier) => s.id == id)

# Find a supplier by id, or an Err naming the missing id.
def supplier_or_err(id: Int) -> Result[Supplier, Text] =
  ok_or(find_supplier(id), "unknown supplier: " ++ text_of_int(id))

# The lead time in days for a supplier id; unknown suppliers count as zero.
def supplier_lead_days(id: Int) -> Int =
  match find_supplier(id) {
    Some(s) => s.lead_days,
    None => 0,
  }

# A routing entry mapping one sku to its preferred supplier.
type SupplierRoute = {sku: Text, supplier_id: Int}

# The preferred supplier for every sku the store stocks.
def supplier_routes: List[SupplierRoute] = [
  {sku: "TEA-001", supplier_id: 1},
  {sku: "TEA-002", supplier_id: 1},
  {sku: "MUG-001", supplier_id: 2},
  {sku: "POT-001", supplier_id: 4},
  {sku: "HNY-001", supplier_id: 3},
  {sku: "KTL-001", supplier_id: 4}
]

# The preferred supplier id for a sku; unrouted skus fall back to supplier 1.
def supplier_for_sku(sku: Text) -> Int =
  match find(supplier_routes, (r: SupplierRoute) => r.sku == sku) {
    Some(r) => r.supplier_id,
    None => 1,
  }

# A purchase order; the [W42] invariant makes zero-unit orders unrepresentable.
type PurchaseOrder = {id: Int, sku: Text, qty: Int, supplier_id: Int} where qty > 0

# A reorder point: reorder a sku once its stock falls below this threshold.
type ReorderPoint = {sku: Text, threshold: Int}

# The reorder-point policy for the demo store, in catalog order.
def reorder_points: List[ReorderPoint] = [
  {sku: "TEA-001", threshold: 10},
  {sku: "TEA-002", threshold: 10},
  {sku: "MUG-001", threshold: 15},
  {sku: "POT-001", threshold: 5},
  {sku: "HNY-001", threshold: 8},
  {sku: "KTL-001", threshold: 10}
]

# The reorder threshold for a sku; skus without a policy never trigger.
def reorder_threshold(points: List[ReorderPoint], sku: Text) -> Int =
  match find(points, (p: ReorderPoint) => p.sku == sku) {
    Some(p) => p.threshold,
    None => 0,
  }

# Whether a sku's stock has fallen below its reorder threshold.
def below_reorder(inv: List[Stock], points: List[ReorderPoint], sku: Text) -> Bool =
  stock_qty(inv, sku) < reorder_threshold(points, sku)

# Every sku currently below its reorder point, in policy order.
def low_stock_skus(inv: List[Stock], points: List[ReorderPoint]) -> List[Text] =
  map(filter(points, (p: ReorderPoint) => below_reorder(inv, points, p.sku)),
    (p: ReorderPoint) => p.sku)

# Units to reorder for a sku: refill to double the threshold, at least one unit.
def reorder_qty(inv: List[Stock], points: List[ReorderPoint], sku: Text) -> Int =
  max(1, 2 * reorder_threshold(points, sku) - stock_qty(inv, sku))

# Build a purchase order for a sku, routed to its preferred supplier.
def make_purchase_order(id: Int, sku: Text, qty: Int where qty > 0) -> PurchaseOrder =
  PurchaseOrder{id: id, sku: sku, qty: qty, supplier_id: supplier_for_sku(sku)}

# Generate a purchase order for every low-stock sku, ids counting up from first_id.
def generate_purchase_orders(inv: List[Stock], points: List[ReorderPoint], first_id: Int) -> List[PurchaseOrder] = {
  let low = low_stock_skus(inv, points);
  map(zip(range(0, len(low)), low), (pair: {fst: Int, snd: Text}) =>
    make_purchase_order(first_id + pair.fst, pair.snd, reorder_qty(inv, points, pair.snd)))
}

# Receive a purchase order into inventory via restock; unknown skus Err.
def receive_purchase_order(inv: List[Stock], po: PurchaseOrder) -> Result[List[Stock], Text] =
  restock(inv, po.sku, po.qty)

# Receive a whole batch of purchase orders, or Err on the first unknown sku.
def receive_all(inv: List[Stock], pos: List[PurchaseOrder]) -> Result[List[Stock], Text] =
  match pos {
    [] => Ok(inv),
    [po, ..rest] => {
      let next = receive_purchase_order(inv, po)?;
      receive_all(next, rest)
    },
  }

# A one-line purchase order summary naming the product and its supplier.
def po_summary(po: PurchaseOrder) -> Text =
  "PO#" ++ text_of_int(po.id) ++ ": " ++ text_of_int(po.qty)
    ++ " x " ++ display_name(po.sku)
    ++ " from " ++ (match find_supplier(po.supplier_id) {
      Some(s) => s.name,
      None => "supplier #" ++ text_of_int(po.supplier_id),
    })
    ++ ", due in " ++ text_of_int(supplier_lead_days(po.supplier_id)) ++ " days"

# ------------------------------------------------------------
# 15. Promotions & bundles
# ------------------------------------------------------------

# A promotional bundle: one unit of every listed sku for a single price.
type Bundle = {name: Text, skus: List[Text], bundle_cents: Int}

# The bundle promotions the store currently runs.
def bundle_catalog: List[Bundle] = [
  {name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400},
  {name: "Brew Starter", skus: ["TEA-001", "MUG-001"], bundle_cents: 2800},
  {name: "Ceremony Set", skus: ["POT-001", "KTL-001", "TEA-002"], bundle_cents: 15000},
  {name: "Sweet Sip", skus: ["TEA-002", "HNY-001"], bundle_cents: 2100}
]

# The cart lines a bundle stands for: one unit of every sku it contains.
def bundle_lines(b: Bundle) -> List[Line] =
  map(b.skus, (s: Text) => {sku: s, qty: 1})

# What the bundle's skus cost bought separately, via cart_subtotal.
def bundle_separate_cents(b: Bundle) -> Result[Int, Text] =
  cart_subtotal(bundle_lines(b))

# Whether a cart contains at least one unit of every sku in the bundle.
def bundle_applies(cart: List[Line], b: Bundle) -> Bool =
  fold(b.skus, true, (acc: Bool, s: Text) => acc and cart_qty(cart, s) > 0)

# The cents saved buying the bundle instead of its skus separately, never negative.
def bundle_savings(b: Bundle) -> Result[Int, Text] = {
  let separate = bundle_separate_cents(b)?;
  Ok(max(0, separate - b.bundle_cents))
}

# Bundle savings as a plain Int; bundles with unknown skus count as saving zero.
def savings_or_zero(b: Bundle) -> Int =
  match bundle_savings(b) {
    Ok(s) => s,
    Err(_) => 0,
  }

# Every bundle in a list that applies to the given cart, in listed order.
def applicable_bundles(cart: List[Line], bs: List[Bundle]) -> List[Bundle] =
  filter(bs, (b: Bundle) => bundle_applies(cart, b))

# The bundle with the highest savings; ties keep the bundle appearing earlier.
def best_bundle_of(bs: List[Bundle]) -> Option[Bundle] =
  match bs {
    [] => None,
    [b, ..rest] => match best_bundle_of(rest) {
      None => Some(b),
      Some(c) => if savings_or_zero(c) > savings_or_zero(b) then Some(c) else Some(b),
    },
  }

# The best applicable bundle for a cart: max savings, ties to the first listed.
def best_bundle(cart: List[Line], bs: List[Bundle]) -> Option[Bundle] =
  best_bundle_of(applicable_bundles(cart, bs))

# A one-line bundle offer, e.g. "Tea Duo: $24.00 (save $2.00)".
def bundle_label(b: Bundle) -> Text =
  b.name ++ ": " ++ format_cents(b.bundle_cents)
    ++ " (save " ++ format_cents(savings_or_zero(b)) ++ ")"

# ------------------------------------------------------------
# 16. Analytics
# ------------------------------------------------------------

# One month of trading: the month number and the orders it produced.
type MonthOrders = {month: Int, orders: List[Order]}

# A month paired with the revenue it earned, in cents.
type MonthRevenue = {month: Int, revenue: Int}

# One customer's order history, for lifetime-spend analytics.
type CustomerOrders = {customer_id: Int, orders: List[Order]}

# Per-month revenue for a trading history, reusing total_revenue.
def monthly_revenue(ms: List[MonthOrders]) -> List[MonthRevenue] =
  map(ms, (m: MonthOrders) => {month: m.month, revenue: total_revenue(m.orders)})

# Just the revenue numbers of a trading history, in month order.
def revenue_series(ms: List[MonthOrders]) -> List[Int] =
  map(monthly_revenue(ms), (r: MonthRevenue) => r.revenue)

# Percent growth from prev to cur in integer math; growth from zero counts as zero.
def growth_percent(prev: Int where prev >= 0, cur: Int where cur >= 0) -> Int =
  if prev == 0 then 0 else (cur - prev) * 100 / prev

# Pairwise month-over-month growth percents for a revenue series.
def growth_series(revenues: List[Int]) -> List[Int] =
  match revenues {
    [] => [],
    [a, ..rest] => match rest {
      [] => [],
      [b, .._] => [growth_percent(a, b)] ++ growth_series(rest),
    },
  }

# Month-over-month growth percents straight from a trading history.
def mom_growth(ms: List[MonthOrders]) -> List[Int] =
  growth_series(revenue_series(ms))

# A customer's lifetime spend: total revenue across their whole history.
def lifetime_spend(co: CustomerOrders) -> Int =
  total_revenue(co.orders)

# The history with the highest lifetime spend; ties keep the earlier customer.
def top_spender(cos: List[CustomerOrders]) -> Option[CustomerOrders] =
  match cos {
    [] => None,
    [c, ..rest] => match top_spender(rest) {
      None => Some(c),
      Some(b) => if lifetime_spend(b) > lifetime_spend(c) then Some(b) else Some(c),
    },
  }

# The id of the customer with the highest lifetime spend; ties go to the first.
def top_customer(cos: List[CustomerOrders]) -> Option[Int] =
  match top_spender(cos) {
    Some(c) => Some(c.customer_id),
    None => None,
  }

# Total revenue in cents across every month of a trading history.
def months_revenue_total(ms: List[MonthOrders]) -> Int =
  fold(monthly_revenue(ms), 0, (acc: Int, r: MonthRevenue) => acc + r.revenue)

# The month entry with the highest revenue; ties keep the earlier month.
def top_month_rev(rs: List[MonthRevenue]) -> Option[MonthRevenue] =
  match rs {
    [] => None,
    [m, ..rest] => match top_month_rev(rest) {
      None => Some(m),
      Some(b) => if b.revenue > m.revenue then Some(b) else Some(m),
    },
  }

# The best-earning month of a trading history; ties go to the earlier month.
def best_month(ms: List[MonthOrders]) -> Option[Int] =
  match top_month_rev(monthly_revenue(ms)) {
    Some(m) => Some(m.month),
    None => None,
  }

# A one-line analytics summary of months, revenue, and the top customer.
def analytics_summary(ms: List[MonthOrders], cos: List[CustomerOrders]) -> Text =
  text_of_int(len(ms)) ++ " months, revenue " ++ format_cents(months_revenue_total(ms))
    ++ ", top customer: "
    ++ (match top_customer(cos) {
      Some(id) => customer_display(id),
      None => "n/a",
    })

# ------------------------------------------------------------
# Tests — 14. Suppliers & purchase orders
# ------------------------------------------------------------

test "supplier directory has four suppliers" =
  len(suppliers) == 4

test "find supplier hit and miss" =
  match find_supplier(2) {
    Some(s) => s.name == "Kiln Works" and find_supplier(99) == None,
    None => false,
  }

test "supplier or err names the id" =
  supplier_or_err(9) == Err("unknown supplier: 9")

test "supplier lead days default to zero" =
  supplier_lead_days(2) == 21 and supplier_lead_days(99) == 0

test "supplier route picks the vendor" =
  supplier_for_sku("HNY-001") == 3 and supplier_for_sku("NOPE") == 1

test "reorder threshold absent is zero" =
  reorder_threshold(reorder_points, "MUG-001") == 15
    and reorder_threshold(reorder_points, "NOPE") == 0

test "below reorder reads the inventory" =
  below_reorder(initial_stock, reorder_points, "POT-001")
    and not below_reorder(initial_stock, reorder_points, "TEA-001")

test "low stock skus in policy order" =
  low_stock_skus(initial_stock, reorder_points) == ["MUG-001", "POT-001", "KTL-001"]

test "reorder qty refills to double the threshold" =
  reorder_qty(initial_stock, reorder_points, "MUG-001") == 18
    and reorder_qty(initial_stock, reorder_points, "POT-001") == 6

test "reorder qty is always positive" (s: Int where s >= 0 and s < 1000, t: Int where t >= 0 and t < 1000) =
  reorder_qty([Stock{sku: "X", qty: s}], [{sku: "X", threshold: t}], "X") >= 1

test "generate purchase orders covers every low sku" =
  generate_purchase_orders(initial_stock, reorder_points, 100)
    == [PurchaseOrder{id: 100, sku: "MUG-001", qty: 18, supplier_id: 2},
        PurchaseOrder{id: 101, sku: "POT-001", qty: 6, supplier_id: 4},
        PurchaseOrder{id: 102, sku: "KTL-001", qty: 14, supplier_id: 4}]

test "healthy inventory generates no purchase orders" =
  match receive_all(initial_stock, generate_purchase_orders(initial_stock, reorder_points, 1)) {
    Ok(inv) => len(generate_purchase_orders(inv, reorder_points, 1)) == 0,
    Err(_) => false,
  }

test "receiving a purchase order restocks it" =
  match receive_purchase_order(initial_stock, make_purchase_order(1, "KTL-001", 14)) {
    Ok(inv) => stock_qty(inv, "KTL-001") == 20,
    Err(_) => false,
  }

test "receiving an unknown sku errs" =
  receive_purchase_order(initial_stock,
    PurchaseOrder{id: 1, sku: "NOPE", qty: 5, supplier_id: 1})
    == Err("cannot restock unknown sku: NOPE")

test "receiving adds exactly its qty" (q: Int where q > 0 and q < 100000) =
  match receive_purchase_order(initial_stock, make_purchase_order(1, "TEA-001", q)) {
    Ok(inv) => stock_qty(inv, "TEA-001") == 40 + q,
    Err(_) => false,
  }

test "receive all clears every reorder" =
  match receive_all(initial_stock, generate_purchase_orders(initial_stock, reorder_points, 1)) {
    Ok(inv) => len(low_stock_skus(inv, reorder_points)) == 0
      and total_units(inv) == total_units(initial_stock) + 38,
    Err(_) => false,
  }

test "po summary names product and supplier" =
  po_summary(make_purchase_order(7, "MUG-001", 18))
    == "PO#7: 18 x Stoneware Mug from Kiln Works, due in 21 days"

# ------------------------------------------------------------
# Tests — 15. Promotions & bundles
# ------------------------------------------------------------

test "bundle catalog has four bundles" =
  len(bundle_catalog) == 4

test "bundle lines are one unit each" =
  bundle_lines({name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400})
    == [{sku: "TEA-001", qty: 1}, {sku: "TEA-002", qty: 1}]

test "bundle separate cents sums unit prices" =
  bundle_separate_cents({name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400})
    == Ok(2600)
    and bundle_separate_cents({name: "Ceremony Set", skus: ["POT-001", "KTL-001", "TEA-002"], bundle_cents: 15000})
    == Ok(16650)

test "bundle savings against separate prices" =
  bundle_savings({name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400}) == Ok(200)
    and bundle_savings({name: "Ceremony Set", skus: ["POT-001", "KTL-001", "TEA-002"], bundle_cents: 15000}) == Ok(1650)

test "unknown bundle sku errs and counts zero" = {
  let ghost = {name: "Ghost", skus: ["NOPE"], bundle_cents: 100};
  bundle_savings(ghost) == Err("unknown sku: NOPE") and savings_or_zero(ghost) == 0
}

test "bundle applies only when every sku is present" = {
  let duo = {name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400};
  bundle_applies(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-002", 3), duo)
    and not bundle_applies(add_to_cart([], "TEA-001", 5), duo)
}

test "every bundle applies to its own lines" =
  fold(bundle_catalog, true, (acc: Bool, b: Bundle) =>
    acc and bundle_applies(bundle_lines(b), b))

test "applicable bundles filters the catalog" = {
  let cart = add_to_cart(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-002", 1), "MUG-001", 2);
  map(applicable_bundles(cart, bundle_catalog), (b: Bundle) => b.name)
    == ["Tea Duo", "Brew Starter"]
}

test "best bundle maximises savings" = {
  let cart = add_to_cart(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-002", 1), "MUG-001", 2);
  match best_bundle(cart, bundle_catalog) {
    Some(b) => b.name == "Brew Starter",
    None => false,
  }
}

test "best bundle tie goes to first listed" = {
  let cart = add_to_cart(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-002", 1), "HNY-001", 1);
  match best_bundle(cart, bundle_catalog) {
    Some(b) => b.name == "Tea Duo" and savings_or_zero(b) == 200,
    None => false,
  }
}

test "best bundle of an empty cart is None" =
  best_bundle([], bundle_catalog) == None

test "bundle label shows price and savings" =
  bundle_label({name: "Tea Duo", skus: ["TEA-001", "TEA-002"], bundle_cents: 2400})
    == "Tea Duo: $24.00 (save $2.00)"

# ------------------------------------------------------------
# Tests — 16. Analytics
# ------------------------------------------------------------

test "monthly revenue reuses total revenue" =
  monthly_revenue([
    {month: 1, orders: [{id: 1, lines: [], state: Placed, total_cents: 10000}]},
    {month: 2, orders: [{id: 2, lines: [], state: Shipped, total_cents: 12000},
                        {id: 3, lines: [], state: Draft, total_cents: 9999},
                        {id: 4, lines: [], state: Placed, total_cents: 3000}]}
  ]) == [{month: 1, revenue: 10000}, {month: 2, revenue: 15000}]

test "growth percent uses integer math" =
  growth_percent(300, 400) == 33 and growth_percent(400, 300) == -25

test "growth from zero is guarded" (c: Int where c >= 0 and c < 1000000) =
  growth_percent(0, c) == 0

test "flat revenue is zero growth" (r: Int where r >= 0 and r < 1000000) =
  growth_percent(r, r) == 0

test "doubling revenue is one hundred percent" (r: Int where r > 0 and r < 1000000) =
  growth_percent(r, 2 * r) == 100

test "growth series is pairwise" =
  growth_series([100, 150, 75]) == [50, -50]
    and len(growth_series([])) == 0
    and len(growth_series([42])) == 0

test "month over month growth from orders" =
  mom_growth([
    {month: 1, orders: [{id: 1, lines: [], state: Placed, total_cents: 10000}]},
    {month: 2, orders: [{id: 2, lines: [], state: Shipped, total_cents: 15000}]}
  ]) == [50]

test "lifetime spend counts revenue states only" =
  lifetime_spend({customer_id: 4, orders: [
    {id: 1, lines: [], state: Placed, total_cents: 1200},
    {id: 2, lines: [], state: Draft, total_cents: 8000},
    {id: 3, lines: [], state: Shipped, total_cents: 300}]}) == 1500

test "top customer by lifetime spend" =
  top_customer([
    {customer_id: 2, orders: [{id: 1, lines: [], state: Placed, total_cents: 5000}]},
    {customer_id: 3, orders: [{id: 2, lines: [], state: Placed, total_cents: 4000},
                              {id: 3, lines: [], state: Shipped, total_cents: 2000}]}
  ]) == Some(3)

test "top customer tie goes to first" =
  top_customer([
    {customer_id: 2, orders: [{id: 1, lines: [], state: Placed, total_cents: 5000}]},
    {customer_id: 3, orders: [{id: 2, lines: [], state: Placed, total_cents: 4000},
                              {id: 3, lines: [], state: Shipped, total_cents: 1000}]}
  ]) == Some(2)

test "top customer of none is None" =
  top_customer([]) == None

test "best month picks the peak" =
  best_month([
    {month: 1, orders: [{id: 1, lines: [], state: Placed, total_cents: 10000}]},
    {month: 2, orders: [{id: 2, lines: [], state: Shipped, total_cents: 15000}]},
    {month: 3, orders: [{id: 3, lines: [], state: Cancelled, total_cents: 90000}]}
  ]) == Some(2) and best_month([]) == None

test "analytics summary formats one line" =
  analytics_summary(
    [{month: 1, orders: [{id: 1, lines: [], state: Placed, total_cents: 10000}]},
     {month: 2, orders: [{id: 2, lines: [], state: Shipped, total_cents: 15000}]}],
    [{customer_id: 1, orders: [{id: 9, lines: [], state: Placed, total_cents: 2500}]}])
    == "2 months, revenue $250.00, top customer: Ada Chen <ada@example.com>"

test "empty analytics summary still reads" =
  analytics_summary([], []) == "0 months, revenue $0.00, top customer: n/a"

# ------------------------------------------------------------
# 14–16 extras: procurement, promotion & analytics reporting
# ------------------------------------------------------------

# The supplier with the longest lead time in a list; ties keep the earlier one.
def slowest_of(ss: List[Supplier]) -> Option[Supplier] =
  match ss {
    [] => None,
    [s, ..rest] => match slowest_of(rest) {
      None => Some(s),
      Some(b) => if b.lead_days > s.lead_days then Some(b) else Some(s),
    },
  }

# The slowest supplier in the whole directory, if the directory is non-empty.
def slowest_supplier: Option[Supplier] =
  slowest_of(suppliers)

# Total units on order across a batch of purchase orders.
def po_batch_units(pos: List[PurchaseOrder]) -> Int =
  fold(pos, 0, (acc: Int, po: PurchaseOrder) => acc + po.qty)

# A multi-line procurement report: one po_summary line per purchase order.
def po_report(pos: List[PurchaseOrder]) -> Text =
  join(map(pos, (po: PurchaseOrder) => po_summary(po)), "\n")

# A multi-line promo menu: one bundle_label per bundle applicable to the cart.
def bundle_offers(cart: List[Line], bs: List[Bundle]) -> Text =
  join(map(applicable_bundles(cart, bs), (b: Bundle) => bundle_label(b)), "\n")

# Average monthly revenue in cents; an empty history averages to zero.
def average_monthly_revenue(ms: List[MonthOrders]) -> Int =
  if len(ms) == 0 then 0 else months_revenue_total(ms) / len(ms)

# Render a growth percent with an explicit sign, e.g. "+50%", "-25%", "0%".
def growth_label(p: Int) -> Text =
  if p > 0 then "+" ++ text_of_int(p) ++ "%" else text_of_int(p) ++ "%"

# ------------------------------------------------------------
# Tests — 14–16 extras
# ------------------------------------------------------------

test "slowest supplier has the longest lead" =
  match slowest_supplier {
    Some(s) => s.name == "Ironline Metals" and s.lead_days == 30,
    None => false,
  }

test "slowest of an empty directory is None" =
  slowest_of([]) == None

test "po batch units totals the batch" =
  po_batch_units(generate_purchase_orders(initial_stock, reorder_points, 100)) == 38

test "po report lists every purchase order" = {
  let r = po_report(generate_purchase_orders(initial_stock, reorder_points, 100));
  contains(r, "PO#100") and contains(r, "PO#102") and contains(r, "Ironline Metals")
}

test "empty batch makes an empty report" =
  po_report([]) == "" and po_batch_units([]) == 0

test "bundle offers menu lists applicable labels" = {
  let cart = add_to_cart(add_to_cart(add_to_cart([], "TEA-001", 1), "TEA-002", 1), "MUG-001", 2);
  let menu = bundle_offers(cart, bundle_catalog);
  contains(menu, "Tea Duo: $24.00 (save $2.00)")
    and contains(menu, "Brew Starter: $28.00 (save $2.50)")
    and not contains(menu, "Ceremony Set")
}

test "average monthly revenue guards empty histories" =
  average_monthly_revenue([
    {month: 1, orders: [{id: 1, lines: [], state: Placed, total_cents: 10000}]},
    {month: 2, orders: [{id: 2, lines: [], state: Shipped, total_cents: 15000}]}
  ]) == 12500 and average_monthly_revenue([]) == 0

test "growth label signs the percent" =
  growth_label(50) == "+50%" and growth_label(-25) == "-25%" and growth_label(0) == "0%"

test "growth label always ends in percent" (p: Int where p > -100000 and p < 100000) =
  contains(growth_label(p), "%")

# ------------------------------------------------------------
# Tests — Gold-tier restocking-fee waiver (scaled Phase 4 change)
# ------------------------------------------------------------

test "gold waives the unwanted restocking fee" =
  compute_refund_for({id: 20, lines: [], state: Placed, total_cents: 5550}, Unwanted, Gold)
    == Ok(Refund{order_id: 20, amount_cents: 5550, fee_cents: 0})

test "gold unwanted fee is always zero" (g: Int where g >= 0 and g < 10000000) =
  restocking_fee_for(g, Unwanted, Gold) == 0

test "silver and bronze still pay the unwanted fee" =
  compute_refund_for({id: 21, lines: [], state: Shipped, total_cents: 5550}, Unwanted, Silver)
    == Ok(Refund{order_id: 21, amount_cents: 4995, fee_cents: 555})
    and compute_refund_for({id: 22, lines: [], state: Placed, total_cents: 5550}, Unwanted, Bronze)
    == Ok(Refund{order_id: 22, amount_cents: 4995, fee_cents: 555})

test "bronze tier matches the untiered refund" (t: Int where t >= 0 and t < 10000000) =
  compute_refund_for({id: 23, lines: [], state: Placed, total_cents: t}, Unwanted, Bronze)
    == compute_refund({id: 23, lines: [], state: Placed, total_cents: t}, Unwanted)

test "defective refunds ignore the tier" =
  compute_refund_for({id: 24, lines: [], state: Placed, total_cents: 5550}, Defective, Gold)
    == Ok(Refund{order_id: 24, amount_cents: 5550, fee_cents: 0})
    and compute_refund_for({id: 24, lines: [], state: Placed, total_cents: 5550}, Defective, Silver)
    == Ok(Refund{order_id: 24, amount_cents: 5550, fee_cents: 0})
    and compute_refund_for({id: 24, lines: [], state: Placed, total_cents: 5550}, Defective, Bronze)
    == Ok(Refund{order_id: 24, amount_cents: 5550, fee_cents: 0})

test "defective fee is zero at every tier" (g: Int where g >= 0 and g < 10000000) =
  restocking_fee_for(g, Defective, Gold) == 0
    and restocking_fee_for(g, Defective, Silver) == 0
    and restocking_fee_for(g, Defective, Bronze) == 0

test "ledger tier drives the refund waiver" = {
  let led = [Loyalty{customer_id: 1, points: 6000}, Loyalty{customer_id: 2, points: 1500}];
  compute_refund_for({id: 25, lines: [], state: Placed, total_cents: 1000}, Unwanted, customer_tier(led, 1))
    == Ok(Refund{order_id: 25, amount_cents: 1000, fee_cents: 0})
    and compute_refund_for({id: 26, lines: [], state: Placed, total_cents: 1000}, Unwanted, customer_tier(led, 2))
    == Ok(Refund{order_id: 26, amount_cents: 900, fee_cents: 100})
}

test "gold batch refunds keep no fees" = {
  let orders = [{id: 1, lines: [], state: Placed, total_cents: 1000},
                {id: 2, lines: [], state: Draft, total_cents: 1000},
                {id: 3, lines: [], state: Shipped, total_cents: 2000}];
  refund_all_for(orders, Unwanted, Gold)
    == [Refund{order_id: 1, amount_cents: 1000, fee_cents: 0},
        Refund{order_id: 3, amount_cents: 2000, fee_cents: 0}]
}

test "gold return processing waives the fee end to end" =
  match place_order(new_order(64, add_to_cart([], "MUG-001", 2)), initial_stock, []) {
    Ok(pl) => match process_return_for(pl.order, pl.inv, Unwanted, Gold) {
      Ok(out) => out.inv == initial_stock
        and out.order.state == Cancelled
        and out.refund == Refund{order_id: 64, amount_cents: pl.order.total_cents, fee_cents: 0},
      Err(_) => false,
    },
    Err(_) => false,
  }
